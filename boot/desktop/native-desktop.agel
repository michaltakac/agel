; The native desktop's still frame, in ordinary Agel syntax, compiled into the
; boot image by the bounded native-vector build adapter and revalidated by the
; unprivileged compositor before it touches the framebuffer. Live semantic
; forms derive frames from this value: the workspace number, the title, the
; accent, the prompt and the status are replaced at run time.
;
; Laid out for 1920x1080 in COSMIC's design tokens: neutral surfaces from its
; dark palette, 8 and 16 pixel corner radii, spacing in steps of 8, Fira Sans
; for the interface and Fira Mono for the workshop's input. Sprites come from
; scripts/build-sprites.py: 0 cursor, 1 agel, 2 terminal, 3 files, 4 editor,
; 5 settings, 6 store, 7 help, 8 minimize, 9 maximize, 10 close, 11 search.
(native-vector-frame 1920 1080
  ; Wallpaper: a dusk gradient with soft glows.
  (background-gradient "#1d2636" "#0c0f16")
  (surface 1240 0 720 720 360 "#2f4a7a" 44)
  (surface 1380 100 480 480 240 "#39598f" 36)
  (surface 0 600 600 600 300 "#3b2a5e" 44)
  (surface 60 720 360 360 180 "#4a3577" 32)

  ; Top panel.
  (surface 0 0 1920 40 0 "#1b1b1b" 236)
  (surface 0 40 1920 1 0 "#2e2e2e" 255)
  (label 24 10 1 16 "#dedede" "Applications")
  (label 150 10 1 16 "#dedede" "Workspaces")
  (surface 268 6 28 28 8 "#e79cfe" 255)
  (label 277 10 1 16 "#1b1b1b" "1")
  (label 312 10 0 16 "#9e9e9e" "2")
  (label 340 10 0 16 "#9e9e9e" "3")
  (label 860 10 1 16 "#dedede" "Workspace 1")
  (surface 1836 13 14 14 7 "#e79cfe" 255)
  (label 1860 10 0 16 "#dedede" "Agel")

  ; The workshop window: a shadow, the frame, a title bar with controls.
  (shadow 60 72 1800 848 16 32 120)
  (surface 60 72 1800 848 16 "#1b1b1b" 250)
  (surface 61 73 1798 846 15 "#262626" 255)
  (surface 60 72 1800 52 16 "#1f1f1f" 255)
  (surface 60 108 1800 16 0 "#1f1f1f" 255)
  (surface 60 123 1800 1 0 "#333333" 255)
  (label 88 86 1 20 "#dedede" "Workshop")
  (label 200 90 0 16 "#808080" "agents all the way down")
  (sprite 1764 90 8 "#9e9e9e" 255)
  (sprite 1800 90 9 "#9e9e9e" 255)
  (sprite 1836 90 10 "#9e9e9e" 255)

  ; Sidebar: spaces and agents.
  (surface 84 148 320 748 8 "#1f1f1f" 255)
  (label 104 164 1 14 "#808080" "SPACES")
  (surface 96 192 296 48 8 "#e79cfe" 255)
  (label 116 204 1 16 "#1b1b1b" "Workspace 1")
  (label 116 260 0 16 "#dedede" "Projects")
  (label 116 312 0 16 "#dedede" "Workshop")
  (label 116 364 0 16 "#dedede" "Settings")
  (surface 96 412 296 1 0 "#333333" 255)
  (label 104 428 1 14 "#808080" "AGENTS")
  (surface 116 460 10 10 5 "#5edb8c" 255)
  (label 140 452 0 16 "#dedede" "planner")
  (surface 116 496 10 10 5 "#5edb8c" 255)
  (label 140 488 0 16 "#dedede" "editor")
  (surface 116 532 10 10 5 "#9e9e9e" 255)
  (label 140 524 0 16 "#9e9e9e" "recovery")

  ; Content: a heading, then two cards.
  (label 452 160 0 14 "#e79cfe" "LIVE AGENTIC WORKSPACE")
  (label 452 184 1 32 "#ffffff" "MOLD THE SYSTEM AS IT RUNS")
  (label 452 236 0 16 "#9e9e9e" "Say what should change.")

  (surface 452 292 664 220 16 "#1f1f1f" 255)
  (gradient-rounded-rectangle 484 324 72 72 18 "#e79cfe" "#cf7dff")
  (sprite 504 344 1 "#1b1b1b" 255)
  (label 580 332 1 20 "#dedede" "3 agents ready")
  (label 580 364 0 16 "#9e9e9e" "Safe preview active")
  (label 484 440 0 16 "#808080" "Committed as revision 0")

  (surface 1148 292 664 220 16 "#1f1f1f" 255)
  (label 1180 324 1 20 "#dedede" "Kernel")
  (label 1180 360 0 16 "#9e9e9e" "Slot A trusted, no candidate")
  (label 1180 388 0 16 "#9e9e9e" "Contract v1.0; four backends")
  (label 1180 440 0 16 "#808080" "evaluator, storage, display")

  ; Actions.
  (surface 452 828 200 48 24 "#e79cfe" 255)
  (label 500 840 1 16 "#1b1b1b" "Ask Agel")
  (surface 668 828 180 48 24 "#333333" 255)
  (label 716 840 0 16 "#dedede" "Terminal")
  (surface 864 828 216 48 24 "#333333" 255)
  (label 904 840 0 16 "#dedede" "Inspect system")

  ; The dock: a floating bar with seven tiles.
  (shadow 696 924 528 80 16 20 100)
  (surface 696 924 528 80 16 "#1b1b1b" 236)
  (gradient-rounded-rectangle 716 936 56 56 14 "#e79cfe" "#cf7dff")
  (sprite 728 948 1 "#1b1b1b" 255)
  (surface 788 936 56 56 14 "#2b2b2b" 255)
  (sprite 800 948 2 "#dedede" 255)
  (surface 860 936 56 56 14 "#63d0df" 255)
  (sprite 872 948 3 "#1b1b1b" 255)
  (surface 932 936 56 56 14 "#5edb8c" 255)
  (sprite 944 948 4 "#1b1b1b" 255)
  (surface 1004 936 56 56 14 "#ffad00" 255)
  (sprite 1016 948 5 "#1b1b1b" 255)
  (surface 1076 936 56 56 14 "#ff9cb1" 255)
  (sprite 1088 948 6 "#1b1b1b" 255)
  (surface 1148 936 56 56 14 "#2b2b2b" 255)
  (sprite 1160 948 7 "#dedede" 255))
