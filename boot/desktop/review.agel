; A reviewer beside a task: an agent that reads the one line the task
; keeps of its own state (`summary`, the last state line the DOOM agent
; wrote) every step, counts for itself the steps in which the player did
; not move and how much of the route to the exit was covered, and every
; twenty steps decides: if the route shrank by two hundred units or more,
; code says the player progresses and nothing is asked; if the player did
; not move in ten or more of those steps, code says it stalled and asks
; only what to change; otherwise the judge is asked whether the player
; has stalled (a number that could mean fighting or blocked), and if so
; which of the player's own cells should change — the follow longer or
; shorter, the heading's tolerance wider, or nothing — and the reviewer
; redefines that cell in the shared world (`follow-steps`,
; `facing-tolerance`), appends what it changed and why to `notes`, and
; says it on the console. On its first step it reads the tail of `notes`
; and re-applies the last change it made in an earlier run, so a run
; learns from the run before it. Jev decides what the state is; code
; decides what follows; no model writes anything. `rv-needs` is the
; summary file; `rv-step` is the review. Eight cells.
(begin (def rv-reason "watching") (def rv-line "") (def rv-last-x 0) (def rv-last-y 0) (def rv-stalls 0) (def rv-steps 0) (def rv-path-then -1) (def rv-phase 0) (def rv-needs (fn () '((file "summary")))) (def rv-field (fn (n d) (if (= (text-field rv-line n) nil) d (if (= (text-int (text-field rv-line n)) nil) d (text-int (text-field rv-line n)))))) (def rv-num (fn (a n) (if (= (text-int (text-field a n)) nil) 0 (text-int (text-field a n))))))
(begin (def rv-change-question "(judge (choice change \"What should change in the player?\" follow-longer follow-shorter tolerance-wider nothing))") (def rv-has (fn (names name) (if (= names nil) #f (if (= (car names) name) #t (rv-has (cdr names) name))))))
(def rv-step (fn () (begin (if (= rv-steps 0) (rv-recall) nil) (def rv-line (file-read "summary")) (if (= rv-phase 0) (rv-watch) (rv-answer)))))
(begin (def rv-watch (fn () (begin (def rv-steps (+ rv-steps 1)) (def rv-stalls (if (if (= (rv-field 5 0) rv-last-x) (= (rv-field 7 0) rv-last-y) #f) (+ rv-stalls 1) rv-stalls)) (def rv-last-x (rv-field 5 0)) (def rv-last-y (rv-field 7 0)) (if (= rv-path-then -1) (def rv-path-then (rv-field 23 0)) nil) (if (= (- rv-steps (* 20 (/ rv-steps 20))) 0) (rv-review) "wait")))) (def rv-review (fn () (if (< 200 (- rv-path-then (rv-field 23 0))) (rv-note "progressing") (if (< 9 rv-stalls) (rv-ask-change) (rv-ask-stalled))))))
(begin (def rv-ask-stalled (fn () (begin (def rv-phase 1) (model-request (text-concat "(judge (noul stalled \"Stalled? " (text-concat rv-line "\"))"))) "wait"))) (def rv-ask-change (fn () (begin (def rv-phase 2) (model-request rv-change-question) "wait"))) (def rv-answer (fn () (begin (def a (model-result)) (if (= a nil) (if (= rv-phase 1) (rv-ask-stalled) (rv-ask-change)) (if (= rv-phase 1) (rv-stalled a) (rv-change a)))))))
(begin (def rv-stalled (fn (a) (if (< 500 (rv-num a 2)) (rv-ask-change) (rv-note "not stalled")))) (def rv-change (fn (a) (begin (rv-apply (text-field a 3)) (rv-note (text-field a 3))))) (def rv-note (fn (what) (begin (def rv-reason what) (def rv-path-then -1) (def rv-stalls 0) (def rv-phase 0) (console-log (text-concat "review: " what)) (file-append "notes" (text-concat "review: " (text-concat what "\n"))) "wait"))))
(begin (def rv-apply (fn (c) (if (= c "follow-longer") (def follow-steps (+ follow-steps 4)) (if (= c "follow-shorter") (def follow-steps (if (< 4 follow-steps) (- follow-steps 4) follow-steps)) (if (= c "tolerance-wider") (def facing-tolerance (+ facing-tolerance 8)) nil))))) (def rv-last-note (fn (t n) (if (= (text-field t n) nil) "" (if (= (text-field t (+ n 2)) nil) (text-field t (+ n 1)) (rv-last-note t (+ n 2)))))))
(def rv-recall (fn () (if (rv-has (file-list) "notes") (begin (def recalled (rv-last-note (file-read "notes" -400) 0)) (if (= recalled "") nil (begin (rv-apply recalled) (console-log (text-concat "review: recalled " recalled))))) nil)))
