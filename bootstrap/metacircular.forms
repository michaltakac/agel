; Pure expressions shared by the Agel interpreter, Rust seed and CL reference.
; One expression per line, with scalar/list results rather than closure printing.
(begin)
(begin 0 41 42)
(if #f (/ 1 0) 42)
(if nil (/ 1 0) 42)
(if 0 42 (/ 1 0))
(let ((x 20) (y 22)) (+ x y))
(let ((x 40)) (let ((x 1) (y x)) (+ x y)))
(let ((x 1) (x 42)) x)
(let ((x 40)) (+ x 1) (+ x 2))
((fn () 1 42))
((fn (x) (+ x 1) (+ x 2)) 40)
(let ((x 40)) ((fn (f) (let ((x 99)) (f 2))) (fn (y) (+ x y))))
((if #t (fn (x) (+ x 2)) (fn (x) 0)) 40)
(apply (fn (x y) (+ x y)) '(20 22))
(apply apply (list + '(20 22)))
((fn (self) (self self 5)) (fn (self n) (if (= n 0) 1 (* n (self self (- n 1))))))
(list (car '(20 22)) (cdr '(20 22)) (cons 1 '(2 3)))
(get (dict 'a 1 'b 2) 'b)
(keys (assoc (dict 'b 1 'a 2) 'b 3))
(has-key? (dict 'x nil) 'x)
(dissoc (dict 'a 1 'b 2) 'a)
(= (dict 'a 1 'b (list 2)) (dict 'a 1 'b (list 2)))
(= (dict 'a 1 'b 2) (dict 'b 2 'a 1))
(count (dict 'a 1 'b 2))
(get (assoc (dict) (list 1 2) 42) (list 1 2))
(type-of (dict))
(list (text-bytes "Ahoj 👋") (count "Ahoj 👋") (text-byte "A" 0))
(text-slice "Ahoj svet" 0 4)
(text-concat "Ag" "el")
(text-symbol "agel")
(type-of (text-symbol "answer"))
