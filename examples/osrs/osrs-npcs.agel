(module agel/osrs-npcs
  (import agel/sequence)
  (import agel/osrs-bits)
  (export npcs-new npcs-decode)
  (def npcs-new (fn () (dict 'order nil 'npcs (dict))))
  (def retain
    (fn (reader npc order out movement extended)
      (dict 'reader reader 'order (cons (get npc 'index) order)
            'npcs (assoc out (get npc 'index) (assoc (assoc npc 'movement movement) 'extended extended)))))
  (def changed
    (fn (reader npc order out)
      (let ((kind (bits-read reader 2)))
        (if (= (get kind 'value) 3) (dict 'reader (get kind 'reader) 'order order 'npcs out)
            (if (= (get kind 'value) 0)
                (retain (get kind 'reader) npc order out nil #t)
                (let ((run (if (= (get kind 'value) 2) (bits-read (get kind 'reader) 1)
                               (dict 'reader (get kind 'reader) 'value 0))))
                  (let ((move (bits-read (get run 'reader) (if (= (get run 'value) 1) 6 3))))
                    (let ((extended (bits-read (get move 'reader) 1)))
                      (retain (get extended 'reader) npc order out
                        (dict 'kind (get kind 'value) 'run (get run 'value) 'code (get move 'value))
                        (= (get extended 'value) 1))))))))))
  (def tracked
    (fn (reader remaining old saved order out)
      (if (= remaining 0) (dict 'reader reader 'order order 'npcs out)
          (if (= old nil) (signal 'osrs/npc "NPC count exceeds tracked indices")
              (let ((flag (bits-read reader 1)) (npc (get saved (car old))))
                (let ((next (if (= (get flag 'value) 0)
                                (retain (get flag 'reader) npc order out nil #f)
                                (changed (get flag 'reader) npc order out))))
                  (tracked (get next 'reader) (- remaining 1) (cdr old) saved
                           (get next 'order) (get next 'npcs))))))))
  (def signed (fn (n width) (if (< n (if (= width 6) 32 128)) n (- n (if (= width 6) 64 256)))))
  (def spawn-clock
    (fn (reader)
      (let ((present (bits-read reader 1)))
        (if (= (get present 'value) 0) (get present 'reader)
            (let ((code (bits-read (get present 'reader) 2)))
              (get (bits-read (get code 'reader) (get (dict 0 18 1 19 2 20 3 32) (get code 'value))) 'reader))))))
  (def spawn
    (fn (reader index width)
      (let ((dz (bits-read reader width)))
        (let ((jump (bits-read (get dz 'reader) 1)))
          (let ((direction (bits-read (get jump 'reader) 3)))
            (let ((extended (bits-read (spawn-clock (get direction 'reader)) 1)))
              (let ((code (bits-read (get extended 'reader) 2)))
                (let ((type (bits-read (get code 'reader) (get (dict 0 12 1 14 2 17 3 24) (get code 'value)))))
                  (let ((dx (bits-read (get type 'reader) width)))
                    (dict 'reader (get dx 'reader)
                          'npc (dict 'index index 'type (get type 'value)
                            'spawn-dx (signed (get dx 'value) width) 'spawn-dz (signed (get dz 'value) width)
                            'direction (get direction 'value) 'jump (= (get jump 'value) 1)
                            'extended (= (get extended 'value) 1) 'movement nil)))))))))))
  (def additions
    (fn (reader order out width)
      (if (< (bits-left reader) 16)
          (if (< (bits-left reader) 8) (dict 'order (reverse order) 'npcs out 'terminated #f)
              (signal 'osrs/bits "truncated NPC index"))
          (let ((index (bits-read reader 16)))
            (if (= (get index 'value) 65535) (dict 'order (reverse order) 'npcs out 'terminated #t)
                (if (< (count order) 255)
                    (let ((next (spawn (get index 'reader) (get index 'value) width)))
                      (additions (get next 'reader) (cons (get index 'value) order)
                        (assoc out (get index 'value) (get next 'npc)) width))
                    (signal 'osrs/npc "NPC tracking capacity exceeded")))))))
  (def npcs-decode
    (fn (state bytes large)
      (let ((header (bits-read (bits-new bytes) 8)))
        (let ((kept (tracked (get header 'reader) (get header 'value) (get state 'order) (get state 'npcs) nil (dict))))
          (let ((result (additions (get kept 'reader) (get kept 'order) (get kept 'npcs) (if large 8 6))))
            (let ((extended (if (= (get result 'order) nil) #f
                               (foldl (fn (found index) (if (get (get (get result 'npcs) index) 'extended) #t found))
                                      #f (get result 'order)))))
              (if (if extended (= (get result 'terminated) #f) #f)
                  (signal 'osrs/bits "NPC extended info lacks its terminator")
                  (dict 'order (get result 'order) 'npcs (get result 'npcs))))))))))
