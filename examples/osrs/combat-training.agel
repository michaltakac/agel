(module agel/osrs-combat-training
  (import agel/sequence)
  (import agel/osrs-game)
  (import agel/osrs-combat-test)
  (export train-rat-attack)

  (def read-until
    (fn (state ready ticks service packets)
      (if (if (ready state) #t (= ticks 0)) state
        (if (= packets 0) (signal 'osrs/training "combat packet bound exceeded")
          (if (= service 0)
            (read-until (osrs-keepalive state) ready ticks 5 packets)
            (let ((next (osrs-next-packet state)))
              (let ((tick (if (= (get (get next 'packet) 'name) "PLAYER_INFO") 1 0)))
                (read-until (get next 'state) ready (- ticks tick) (- service tick) (- packets 1)))))))))
  (def wait-ticks
    (fn (state ready batches) (read-until state ready (* batches 5) 0 16384)))
  (def await-combat
    (fn (state ready)
      (let ((observed (wait-ticks state ready 48)))
        (if (ready observed) observed (signal 'osrs/training "combat observation timed out")))))
  (def attack (fn (state) (get (osrs-stat state 0) 'xp)))
  (def hitpoints (fn (state) (get (osrs-stat state 3) 'xp)))

  (def observed-rat
    (fn (state index)
      (let ((matches (filter (fn (npc)
                       (if (= (get npc 'index) index) (= (get npc 'type) 2854) #f))
                       (osrs-nearby-npcs state))))
        (if matches (car matches) nil))))
  (def attack-with-retry
    (fn (state index complete remaining)
      (let ((visible (await-combat state (fn (g) (observed-rat g index)))))
        (let ((attempt (wait-ticks (osrs-attack visible index) complete 8)))
          (if (complete attempt) attempt
            (if (= remaining 0)
              (signal 'osrs/training "rat attack did not complete" index)
              (let ((reset (wait-ticks (osrs-walk attempt 3221 3218) complete 3)))
                (if (complete reset) reset
                  (attack-with-retry reset index complete (- remaining 1))))))))))
  (def fight-again
    (fn (state index)
      (let ((complete (fn (g)
                        (if (< (attack state) (attack g))
                          (if (< (hitpoints state) (hitpoints g))
                            (= (observed-rat g index) nil) #f) #f))))
        (let ((finished (attack-with-retry state index complete 3)))
          (dict 'state finished 'report
            (dict 'target-index index 'attack-before (attack state) 'attack-after (attack finished)
              'hitpoints-before (hitpoints state) 'hitpoints-after (hitpoints finished)
              'target-removed #t))))))
  (def train
    (fn (state goal remaining index fights)
      (if (if (< (attack state) goal) (< 0 remaining) #f)
        (let ((encounter (if index (fight-again state index)
                           (test-rat-combat-bounded state await-combat (fn (attacking _) attacking)))))
          (let ((next (get encounter 'state)) (report (get encounter 'report)))
            (train next goal (- remaining 1) (get report 'target-index) (cons report fights))))
        (dict 'state state 'fights (reverse fights)))))

  (def train-rat-attack
    (fn (state goal max-fights)
      (if (if (= (type-of goal) 'int) (if (< 0 goal) (if (= (type-of max-fights) 'int)
          (if (< 0 max-fights) (< max-fights 65) #f) #f) #f) #f)
        (let ((ready (await-combat state (fn (g) (if (osrs-stat g 0) (osrs-stat g 3) #f)))))
          (let ((result (train ready goal max-fights nil nil)))
            (let ((finished (get result 'state)) (fights (get result 'fights)))
              (dict 'test 'rat-training 'passed (if (< (attack finished) goal) #f #t)
                'goal-attack-xp goal 'fights (count fights)
                'attack-before (attack ready) 'attack-after (attack finished)
                'hitpoints-before (hitpoints ready) 'hitpoints-after (hitpoints finished)
                'attack-level (get (osrs-stat finished 0) 'level) 'encounters fights))))
        (signal 'osrs/training "expected positive XP goal and a fight bound of 1..64"))))
)
