(module agel/osrs-mining-test
  (import agel/sequence)
  (import agel/osrs-game)
  (export mine-first-copper smelt-first-bronze sell-first-bronze first-bronze-sale first-bronze-sale-using)
  (def require
    (fn (ok message) (if ok #t (signal 'osrs/mining-test message))))
  (def tutor
    (fn (state)
      (let ((matches (filter (fn (npc) (= (get npc 'type) 3222)) (osrs-nearby-npcs state))))
        (if matches (car matches) nil))))
  (def observe-live
    (fn (state predicate batches)
      (if (if (predicate state) #t (= batches 0)) state
        (observe-live (osrs-observe-bounded (osrs-keepalive state) predicate 5) predicate (- batches 1)))))
  (def walk-to-tutor
    (fn (state x z batches)
      (let ((prior (osrs-map-route state)))
        (observe-live (osrs-walk state x z)
          (fn (observed)
            (let ((route (osrs-map-route observed)))
              (if route
                (if (< (if prior (get prior 'sequence) 0) (get route 'sequence))
                  (if (get route 'cleared)
                    (if (= (list x z) (list (get route 'x) (get route 'z))) (tutor observed) #f)
                    #f)
                  #f)
                #f))) batches))))
  (def approach-tutor
    (fn (state)
      (let ((first (walk-to-tutor state 3227 3149 18)))
        (if (tutor first) first
          (let ((second (walk-to-tutor first 3229 3149 12)))
            (if (tutor second) second
              (signal 'osrs/mining-test "mining tutor was not visible after two approaches"
                (dict 'nearby-types (map (fn (npc) (get npc 'type)) (osrs-nearby-npcs second))
                      'active-world (get second 'active-world) 'map-route (osrs-map-route second)))))))))
  (def wait-live
    (fn (state predicate batches)
      (if (predicate state) state
        (if (= batches 0) (signal 'osrs/mining-test "live observation timed out")
          (wait-live (osrs-wait-ticks (osrs-keepalive state) 5) predicate (- batches 1))))))
  (def pickaxes (fn (g) (osrs-inventory-count g 93 1265)))
  (def ores (fn (g) (osrs-inventory-count g 93 436)))
  (def mining-xp (fn (g) (get (osrs-stat g 14) 'xp)))
  (def await-interface
    (fn (state interface)
      (let ((observed (observe-live state (fn (g) (osrs-open-interface? g interface)) 12)))
        (if (osrs-open-interface? observed interface) observed
          (signal 'osrs/mining-test "expected tutor dialogue" interface)))))
  (def talk-to-tutor
    (fn (state)
      (if (osrs-open-interface? state 219) state
        (begin
          (require (tutor state) "mining tutor left before dialogue")
          (observe-live (osrs-talk state (get (tutor state) 'index))
            (fn (g) (osrs-open-interface? g 219)) 6)))))
  (def tutor-menu
    (fn (state)
      (let ((first (talk-to-tutor (approach-tutor state))))
        (if (osrs-open-interface? first 219) first
          (let ((nearby (observe-live (osrs-wait-ticks (osrs-walk first 3229 3149) 5) tutor 6)))
            (let ((second (talk-to-tutor nearby)))
              (if (osrs-open-interface? second 219) second
                (signal 'osrs/mining-test "mining tutor did not open a menu after two talks"
                  (osrs-map-route second)))))))))
  (def first-copper-state
    (fn (state)
      (let ((ready (osrs-await state (fn (g) (if (osrs-stat g 14) (has-key? (get g 'inventories) 93) #f)))))
        (require (= (list (mining-xp ready) (pickaxes ready) (ores ready)) '(0 0 0))
          "expected a fresh account without a pickaxe or ore")
        (let ((menu (tutor-menu ready)))
          (let ((player (await-interface (osrs-resume-dialogue menu 219 1 1) 217)))
            (let ((object (await-interface (osrs-resume-dialogue player 217 5 -1) 193)))
              (let ((gift (await-interface (osrs-resume-dialogue object 193 0 0) 231)))
                (require (= (pickaxes gift) 1) "the mining tutor did not provide a bronze pickaxe")
                (let ((continued (osrs-resume-dialogue gift 231 5 -1)))
                  (let ((mined (with-handler (* problem) (signal 'osrs/mining-test "waiting for copper ore and Mining XP" problem)
                                 (wait-live (osrs-use-location continued 10943 3230 3147)
                                   (fn (g) (if (= (ores g) 1) (< 0 (mining-xp g)) #f)) 18))))
                    (require (= (list (pickaxes mined) (ores mined) (mining-xp mined)) '(1 1 17))
                      "unexpected mining outcome")
                    mined)))))))))
  (def mine-first-copper
    (fn (state)
      (let ((mined (first-copper-state state)))
        (dict 'test 'first-copper 'passed #t 'tutor 3222
          'pickaxes (pickaxes mined) 'copper (ores mined) 'mining-xp (mining-xp mined)))))
  (def tin (fn (g) (osrs-inventory-count g 93 438)))
  (def bronze (fn (g) (osrs-inventory-count g 93 2349)))
  (def smithing-xp (fn (g) (get (osrs-stat g 13) 'xp)))
  (def walk-ticks
    (fn (state batches)
      (if (= batches 0) state
        (walk-ticks (osrs-wait-ticks (osrs-keepalive state) 5) (- batches 1)))))
  (def first-tin
    (fn (state)
      (let ((ready (fn (g) (if (= (tin g) 1) (= (mining-xp g) 35) #f))))
        (let ((attempt (walk-ticks (osrs-use-location state 11360 3225 3148) 6)))
          (if (ready attempt) attempt
            (wait-live (osrs-use-location attempt 11360 3224 3146) ready 18))))))
  (def furnace-open? (fn (state) (osrs-open-interface? state 270)))
  (def open-furnace
    (fn (state)
      (let ((nearby (walk-ticks (osrs-walk state 3226 3255) 10)))
        (let ((first (observe-live (osrs-use-location-option nearby 24009 3226 3256 2) furnace-open? 6)))
          (if (furnace-open? first) first
            (let ((second (observe-live (osrs-use-location-option first 24009 3226 3256 2) furnace-open? 6)))
              (require (furnace-open? second) "furnace did not open after two interactions")
              second))))))
  (def first-bronze
    (fn (state observe)
      (let ((copper (first-copper-state state)))
        (observe "mined copper with the tutor's pickaxe")
        (require (= (list (tin copper) (bronze copper) (smithing-xp copper)) '(0 0 0))
          "expected no tin, bronze or Smithing XP")
        (let ((stock (with-handler (* problem) (signal 'osrs/mining-test "waiting for tin ore" problem)
                       (first-tin copper))))
          (observe "mined tin, returning to the furnace")
          (require (= (list (ores stock) (tin stock) (bronze stock)) '(1 1 0)) "unexpected furnace stock")
          (let ((returned (walk-ticks (osrs-walk (walk-ticks stock 1) 3221 3218) 15)))
            (let ((menu (open-furnace returned)))
              (let ((smelted (with-handler (* problem) (signal 'osrs/mining-test "waiting for bronze bar and Smithing XP" problem)
                               (wait-live (osrs-resume-dialogue menu 270 15 1)
                                 (fn (g) (if (= (bronze g) 1) (< 0 (smithing-xp g)) #f)) 12))))
                (require (= (list (pickaxes smelted) (ores smelted) (tin smelted) (bronze smelted)
                  (mining-xp smelted) (smithing-xp smelted)) '(1 0 0 1 35 6))
                  "unexpected smelting outcome")
                (observe "smelted one bronze bar")
                (dict 'state smelted 'report
                  (dict 'test 'first-bronze 'passed #t 'pickaxes (pickaxes smelted)
                    'copper-before (ores stock) 'tin-before (tin stock) 'bronze-before (bronze stock)
                    'copper-after (ores smelted) 'tin-after (tin smelted) 'bronze-after (bronze smelted)
                    'mining-xp (mining-xp smelted) 'smithing-xp (smithing-xp smelted))))))))))
  (def smelt-first-bronze (fn (state) (get (first-bronze state (fn (_) nil)) 'report)))
  (def coins (fn (g) (osrs-inventory-count g 93 995)))
  (def shopkeeper
    (fn (state)
      (let ((matches (filter (fn (npc) (if (= (get npc 'type) 2813) #t (= (get npc 'type) 2814)))
                       (osrs-nearby-npcs state))))
        (if matches (car matches) nil))))
  (def first-bronze-sale-using
    (fn (state observe)
      (let ((production (first-bronze state observe)))
        (let ((arrived (with-handler (* problem) (signal 'osrs/mining-test "walking to the general store" problem)
                         (wait-live (osrs-walk (get production 'state) 3211 3244) shopkeeper 14))))
          (let ((shop (with-handler (* problem) (signal 'osrs/mining-test "waiting for both shop interfaces" problem)
                        (wait-live (osrs-trade arrived (get (shopkeeper arrived) 'index))
                          (fn (g) (if (osrs-open-interface? g 300) (osrs-open-interface? g 301) #f)) 12))))
            (require (= (list (bronze shop) (coins shop)) '(1 0)) "expected one bar and zero coins before sale")
            (let ((sold (with-handler (* problem) (signal 'osrs/mining-test "waiting for sale and coins" problem)
                          (wait-live (osrs-click-inventory-item shop 301 0 93 2349 2)
                            (fn (g) (if (= (bronze g) 0) (< 0 (coins g)) #f)) 12))))
              (require (= (list (pickaxes sold) (ores sold) (tin sold) (mining-xp sold) (smithing-xp sold)) '(1 0 0 35 6))
                "sale changed unrelated inventory or XP")
              (observe "sold the bronze bar and observed the proceeds")
              (dict 'state sold 'report
                (assoc (assoc (assoc (assoc (get production 'report) 'test 'first-sale)
                  'bronze-after-sale (bronze sold)) 'coins-before (coins shop)) 'coins-after (coins sold)))))))))
  (def first-bronze-sale (fn (state) (first-bronze-sale-using state (fn (_) nil))))
  (def sell-first-bronze (fn (state) (get (first-bronze-sale state) 'report))))
