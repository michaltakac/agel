(module agel/osrs-crafting-test
  (import agel/osrs-game)
  (export stage-adamant-stock forge-adamant-platebody forge-adamant-platebody-using)
  (def assert-craft
    (fn (ok message) (if ok #t (signal 'osrs/craft-test message))))
  (def initial
    (fn (state)
      (osrs-await state (fn (g) (if (osrs-stat g 13) (has-key? (get g 'inventories) 93) #f)))))
  (def bars (fn (state) (osrs-inventory-count state 93 2361)))
  (def hammer (fn (state) (osrs-inventory-count state 93 2347)))
  (def platebody (fn (state) (osrs-inventory-count state 93 1123)))
  (def smithing (fn (state) (get (osrs-stat state 13) 'level)))
  (def xp (fn (state) (get (osrs-stat state 13) 'xp)))
  (def stage-adamant-stock
    (fn (state)
      (let ((ready (initial state)))
        (let ((reset (osrs-await (osrs-command ready "setlevel smithing 1")
                       (fn (g) (= (smithing g) 1)))))
          (let ((stocked (osrs-await
                          (osrs-command (osrs-command (osrs-command (osrs-command reset "invclear")
                            "setlevel smithing 88") "item 2347 1") "item 2361 5")
                          (fn (g) (if (= (smithing g) 88) (if (= (bars g) 5) (= (hammer g) 1) #f) #f)))))
            (assert-craft (= (platebody stocked) 0) "setup left a pre-existing platebody")
            (osrs-wait-ticks (osrs-command stocked "tele 3187 3425") 4))))))
  (def forge-adamant-platebody
    (fn (state) (get (forge-adamant-platebody-using state osrs-await (fn (_) nil)) 'report)))
  (def forge-adamant-platebody-using
    (fn (state await report-phase)
      (report-phase "sending anvil interaction")
      (let ((modal (with-handler (* problem) (signal 'osrs/craft-test "waiting for smithing interface and starting stock" problem)
                     (await (osrs-use-location state 2097 3188 3424)
                       (fn (g) (if (osrs-open-interface? g 312)
                                 (if (osrs-stat g 13) (has-key? (get g 'inventories) 93) #f) #f))))))
        (assert-craft (= (list (smithing modal) (hammer modal) (bars modal) (platebody modal)) '(88 1 5 0))
          "unexpected initial smithing stock")
        (report-phase "smithing interface and stock observed, sending platebody button")
        (let ((finished (with-handler (* problem) (signal 'osrs/craft-test "waiting for platebody and XP" problem)
                          (await (osrs-click-interface modal 312 22)
                            (fn (g) (if (= (platebody g) 1) (< (xp modal) (xp g)) #f))))))
          (assert-craft (= (list (hammer finished) (bars finished) (platebody finished)) '(1 0 1))
            "crafting did not consume five bars and retain the hammer")
          (assert-craft (= (- (xp finished) (xp modal)) 312) "unexpected whole-XP gain")
          (dict 'state finished 'report (dict 'test 'adamant-platebody 'passed #t 'bars-before (bars modal) 'bars-after (bars finished)
            'platebody-before (platebody modal) 'platebody-after (platebody finished)
            'smithing-xp-before (xp modal) 'smithing-xp-after (xp finished))))))))
