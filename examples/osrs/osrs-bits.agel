(module agel/osrs-bits
  (export bits-new bits-read bits-left)
  (def rem (fn (n d) (- n (* d (/ n d)))))
  (def powers (dict 0 1 1 2 2 4 3 8 4 16 5 32 6 64 7 128 8 256))
  (def bits-new
    (fn (bytes)
      (if (if (= bytes nil) #t (= (type-of bytes) 'list))
        (dict 'bytes bytes 'offset 0 'left (* 8 (count bytes)))
        (signal 'osrs/bits "bit reader requires a byte list"))))
  (def bits-left (fn (reader) (get reader 'left)))
  (def read-loop
    (fn (reader remaining out)
      (if (= remaining 0) (dict 'reader reader 'value out)
          (let ((room (- 8 (get reader 'offset))))
            (let ((take (if (< room remaining) room remaining)))
              (let ((digit (rem (/ (car (get reader 'bytes)) (get powers (- room take))) (get powers take))))
                (read-loop
                  (dict 'bytes (if (= room take) (cdr (get reader 'bytes)) (get reader 'bytes))
                        'offset (rem (+ (get reader 'offset) take) 8) 'left (- (get reader 'left) take))
                  (- remaining take) (+ (* out (get powers take)) digit))))))))
  (def bits-read
    (fn (reader width)
      (if (if (= (type-of width) 'int)
              (if (< -1 width) (if (< width 33) (< (- width 1) (bits-left reader)) #f) #f) #f)
          (read-loop reader width 0)
          (signal 'osrs/bits "bit field exceeds packet or width bound")))))
