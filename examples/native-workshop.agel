; Enter these forms after ./scripts/run-qemu.sh. In v1.6 the evaluator is an
; unprivileged domain and its output comes from a separate console domain.
; To retain a form, enter :edit NAME, type the form at the edit prompt, then
; use :run NAME and :save. It will be replayed on the next boot.
(def fact (fn (n) (if (= n 0) 1 (* n (fact (- n 1))))))
(fact 6)
(eval '(+ 20 22))
(def answer 42)
(begin (def answer 99) (/ 1 0))
answer
(def evolve (fn (x) (+ x 1)))
(evolve 41)
(def evolve (fn (x) (+ x 2)))
; Enter :rollback immediately, then (evolve 41) returns 42 from the old definition.
