(begin (repair-agent-exchange worker infer audit) #t)
(begin (repair-agent-exchange worker infer audit) #t)
(begin (repair-agent-exchange worker infer audit) #t)
(begin (repair-agent-exchange worker infer audit) #t)
(def session (repair-state worker))
(check (= (get session 'status) 'done) "repair exhausted or failed")
(check (= (evolution-current (get session 'versions) 'cell 'batches) 2) "tool version did not change")
(check (= (retained-plan 5 3) 2) "retained controller did not use repaired tool")
(check (= controller frozen-controller) "controller or stream-owner identity changed")
(check (= (get (repair-evaluate session 1) 'correct) 3) "frozen control score changed")
(check (= (get (repair-evaluate session 2) 'correct) 6) "repaired replay score")
(audit (dict 'event 'live-tool-versions 'versions (get session 'versions)))
(console-log (text-concat "native-session: candidate " (print-form (get session 'candidate))))
(console-log "native-session: tool repaired: text judge, prediction and held-out replay; frozen 3/6 to repaired 6/6; same repair actor, controller and stream owner")
