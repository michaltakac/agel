(import agel/sequence)
(import agel/evolution)
(import agel/checkpoint)
(import agel/live-runtime)
(import agel/judge-log)
(def check (fn (ok label) (if ok #t (signal 'checkpoint/test label))))
(def append-record (fn (text) (file-append "judge-log" text)))
(def audit (fn (record) (append-record (text-concat (print-form record) "\n"))))
(def judge (fn (request) (judge-with-log 'checkpoint-fixture request
  (fn (diff) (dict 'allowed #t 'reason "deterministic checkpoint fixture" 'cost-microusd 0)) audit)))
(def before '(fn (parts) (cons 'begin parts)))
(def after '(fn (parts) (list 'if (car parts) nil (cons 'begin (cdr parts)))))
(def equivalent (list 'fn '(operands) (list 'apply after '(list operands))))
(def expansions (list (dict 'arguments '((#f 42)) 'expected '(if #f nil (begin 42)))))
(def behavior (list
  (dict 'expression '(unless #t (/ 1 0)) 'bindings (dict) 'expected nil)
  (dict 'expression '(unless #f (+ saved 33)) 'bindings (dict 'saved 9) 'expected 42)))
(def recover (fn () (checkpoint-recover (file-read "judge-log") (evolution-new) evolution-valid?)))
(def persist (fn (store versions) (checkpoint-write store versions print-form evolution-valid? append-record)))
(def verify
  (fn (store expected)
    (let ((versions (get store 'state)))
      (begin
        (check (evolution-valid? versions) "invalid recovered history")
        (check (= (evolution-current versions 'cell 'unless) expected) "wrong active source")
        (check (= (evolution-source versions 1) before) "old source was lost")
        (check (= (get (evolution-replay-version versions 1) 'passed) #t)
          "old replay cases were lost")
        (let ((runtime (runtime-new versions)))
          (let ((receipt ((runtime-activation runtime behavior)
                          (dict 'kind 'cell 'name 'unless 'after (evolution-source versions expected)) nil)))
            (check (= (get receipt 'passed) #t) "recovered source failed runtime replay")))
        (let ((runtime (runtime-new versions)))
          (let ((closure (runtime-eval runtime '(fn (flag) (unless flag (+ saved 33)))
                          (runtime-environment (dict 'saved 9)))))
            (check (= (runtime-apply runtime closure '(#t)) nil) "restored form was not used")
            (check (= (runtime-apply runtime closure '(#f)) 42) "restored lexical evaluation differs")))
        #t))))
