(import agel/repair)
(import agel/sequence)
(import agel/inference)
(import agel/live-runtime)
(import agel/evolution)
(import agel/judge-log)
(def check (fn (ok label) (if ok #t (signal 'runtime/repair-test label))))
(def audit (fn (record) (file-append "judge-log" (text-concat (print-form record) "\n"))))
(def before '(fn (parts) (cons 'begin parts)))
(def versions (evolution-edit (evolution-new) 'cell 'unless nil before
  (list (dict 'arguments '((#f 42)) 'expected '(begin #f 42)))
  (fn (request) (judge-with-log 'bootstrap request
    (fn (diff) (dict 'allowed #t 'reason "frozen runtime control" 'cost-microusd 0)) audit))))
(def runtime (runtime-new versions))
(def retained (runtime-eval runtime '(fn (condition) (unless condition (+ saved 33)))
  (runtime-environment (dict 'saved 9))))
(check (= (runtime-apply runtime retained '(#t)) 42) "observed eager form failure")
(def retained-session (dict 'mailbox '(evaluate continue) 'turn 7))
(def runtime-cases (list
  (dict 'expression '(unless #t (/ 1 0)) 'bindings (dict) 'expected nil)
  (dict 'expression '(unless #f 20 42) 'bindings (dict) 'expected 42)
  (dict 'expression '(let ((n 7)) (unless #f (+ n 1))) 'bindings (dict) 'expected 8)
  (dict 'expression '(quote (unless #f 42)) 'bindings (dict) 'expected '(unless #f 42))
  (dict 'expression '((fn (x) (unless x 42)) #t) 'bindings (dict) 'expected nil)
  (dict 'expression '(unless #f) 'bindings (dict) 'expected nil)))
(def routes (dict 'writer "codex" 'judge "jev"))
(def infer (fn (provider prompt) (inference-call routes model-request provider prompt)))
(def session (repair-start (repair-new
  (dict 'versions versions 'tool 'unless 'before-text "(fn (parts) (cons 'begin parts))"
    'context "Repair a live Agel language form. The evaluator calls this transformer with one argument: the unevaluated list of operands of (unless CONDITION BODY ...). The transformer must return exactly (if CONDITION nil (begin BODY ...)). CONDITION is any AST. There are zero or more body ASTs, and a condition is always present. The runtime evaluates the expansion in the caller's lexical environment. Observed failure: a closure containing (unless #t (+ saved 33)) returned 42 instead of nil because the current expansion is eager begin. Keep operand ASTs unevaluated; quote the symbols if and begin in constructed output. Displayed probes in order: operand list (#t 42) must produce (if #t nil (begin 42)); operand list (#f 1 2) must produce (if #f nil (begin 1 2)). Predictions are those two output ASTs as data, not their execution results."
    'examples (list
      (dict 'arguments '((#t 42)) 'expected '(if #t nil (begin 42)))
      (dict 'arguments '((#f 1 2)) 'expected '(if #f nil (begin 1 2))))
    'held-out (list
      (dict 'arguments '((#f)) 'expected '(if #f nil (begin)))
      (dict 'arguments '(((< n 1) (+ n 1))) 'expected '(if (< n 1) nil (begin (+ n 1))))
      (dict 'arguments '((#t (/ 1 0))) 'expected '(if #t nil (begin (/ 1 0))))
      (dict 'arguments '((flag a b c)) 'expected '(if flag nil (begin a b c))))
    'max-attempts 2 'threshold 800 'proposal-provider 'writer 'judge-provider 'judge
    'defer-activation #t 'activate (runtime-activation runtime runtime-cases)))))
(console-log "runtime-repair: requesting a language-form repair from within Agel OS")
(begin (def session (repair-exchange session infer audit)) #t)
(begin (def session (repair-exchange session infer audit)) #t)
(begin (def session (repair-exchange session infer audit)) #t)
(begin (def session (repair-exchange session infer audit)) #t)
(begin (def session (repair-exchange session infer audit)) #t)
(begin (def session (repair-exchange session infer audit)) #t)
(check (= (get session 'status) 'done) "repair exhausted or failed")
(def active (get session 'versions))
(check (= (evolution-current active 'cell 'unless) 2) "language form was not activated")
(check (= (runtime-apply (runtime-new active) retained '(#t)) nil) "existing closure did not use new language form")
(check (= (runtime-apply (runtime-new active) retained '(#f)) 42) "captured lexical value was lost")
(check (= retained-session (dict 'mailbox '(evaluate continue) 'turn 7)) "controller data changed")
(check (= (get (repair-evaluate session 1) 'correct) 0) "frozen expansion control score")
(check (= (get (repair-evaluate session 2) 'correct) 6) "repaired expansion score")
(def local-judge (fn (request) (judge-with-log 'local-replay request
  (fn (diff) (dict 'allowed #t 'reason "deterministic runtime gate fixture" 'cost-microusd 0)) audit)))
(def unsafe (runtime-revert (runtime-new active) 'unless 1
  (list (dict 'arguments '((#f 42)) 'expected '(begin #f 42))) runtime-cases local-judge))
(check (= (evolution-current (get unsafe 'versions) 'cell 'unless) 2) "unsafe revert escaped runtime replay")
(def chosen (evolution-source active 2))
(def equivalent (list 'fn '(operands) (list 'apply chosen '(list operands))))
(def expansions (append (get session 'examples) (get session 'held-out)))
(def upgraded (runtime-edit unsafe 'unless chosen equivalent expansions runtime-cases local-judge))
(check (= (evolution-current (get upgraded 'versions) 'cell 'unless) 3) "equivalent form did not activate")
(check (= (runtime-apply upgraded retained '(#t)) nil) "same closure did not use equivalent version")
(def reverted (runtime-revert upgraded 'unless 2 expansions runtime-cases local-judge))
(check (= (evolution-current (get reverted 'versions) 'cell 'unless) 4) "guarded revert did not create retained version")
(check (= (runtime-apply reverted retained '(#f)) 42) "same closure lost lexical state after revert")
(def archive (text-concat (print-form (dict 'event 'runtime-versions 'versions (get reverted 'versions))) "\n"))
(file-append "judge-log" archive)
(def stored (file-read "judge-log"))
(check (= (text-slice stored (- (text-bytes stored) (text-bytes archive)) (text-bytes stored)) archive)
  "OS version archive differs")
(console-log (text-concat "runtime-repair: candidate " (print-form (get session 'candidate))))
(console-log (text-concat "runtime-repair: history " (print-form (get (get reverted 'versions) 'history))))
(console-log "runtime-repair: PASS: model form activated; unsafe revert refused; equivalent version and guarded revert applied; same closure and lexical value retained; 6 runtime canaries passed")
#t
