(check recorded-field "no recorded byte field")
(def recorded-hex (get (get recorded-field 'bytes) 'data))
(def observed-length (/ (text-bytes recorded-hex) 2))
(check (if (< 1023 observed-length) (< observed-length 8193) #f) "no suitably sized recorded workload")
((get stream 'pulse))
(def replay-chunks
  (fn (at chunks)
    (if (= at (text-bytes recorded-hex)) chunks
      (let ((end (+ at (if (< 256 (- (text-bytes recorded-hex) at))
                          256 (- (text-bytes recorded-hex) at)))))
        (let ((chunk (bytes-from-hex (text-slice recorded-hex at end))))
          ((get stream 'pulse))
          (replay-chunks end (cons chunk chunks)))))))
(def replay-bytes (foldl (fn (body chunk) (append chunk body)) nil (replay-chunks 0 nil)))
(def run-profile
  (fn (quantum)
    (profile-work (fn (service) (bytes-hex-quantum replay-bytes service quantum))
      (get stream 'pulse) clock-us)))
(def control-quantum (retained-quantum observed-length))
(def run-control
  (fn ()
    (let ((measurement (run-profile control-quantum)))
      (check (= (get measurement 'value) recorded-hex) "control bytes differ from recorded input")
      (get measurement 'metrics))))
(def baseline (run-control))
(def work-budget 3000000)
(def gap-budget 6000000)
(def policy-bound (profile-limit baseline 64 work-budget 4 512))
(def observation (dict 'bytes observed-length 'baseline baseline 'bound policy-bound
  'work-budget-us work-budget 'gap-budget-us gap-budget 'margin 4 'record (get recorded-field 'name)))
(audit (dict 'event 'runtime-observation 'profile observation))
(console-log (text-concat "native-opt: observation " (print-form observation)))
(check (< 127 policy-bound) "recorded work profile does not justify a larger quantum")
(def replay-tape (text-concat (print-form (list 'recorded-workload observed-length recorded-hex)) "\n"))
(def tape-offset (text-bytes (file-read "judge-log")))
(def append-tape
  (fn (at)
    (if (= at (text-bytes replay-tape)) #t
      (let ((end (if (< (+ at 2048) (text-bytes replay-tape)) (+ at 2048) (text-bytes replay-tape))))
        (begin
          ((get stream 'pulse))
          (file-append "judge-log" (text-slice replay-tape at end))
          (append-tape end))))))
(append-tape 0)
(def speed-check
  (fn (metrics before after)
    (let ((elapsed (get metrics 'elapsed-us))
          (first (get before 'elapsed-us)) (last (get after 'elapsed-us)))
      (if (if (< elapsed first) (< elapsed last) #f) nil
        (text-concat "candidate did not beat both adjacent controls (microseconds): "
          (print-form (dict 'candidate elapsed 'before first 'after last)))))))
(def replay-refusal
  (fn (value metrics before after)
    (if (= value recorded-hex)
      (if (< work-budget (get metrics 'work-max-us)) "candidate exceeded the measured work budget"
        (if (< gap-budget (get metrics 'gap-max-us)) "candidate exceeded the measured service gap budget"
          (if (< (get metrics 'calls) (get before 'calls))
            (speed-check metrics before after) "candidate replay did not reduce service calls")))
      "candidate replay changed recorded bytes")))
(def probe
  (fn (state)
    (let ((candidate (meta-eval (get (get state 'candidate) 'after) (meta-base-env))))
      (let ((quantum (check-quantum (meta-apply candidate (list policy-bound)) policy-bound)))
        (check (< 64 quantum) "candidate selected the frozen cadence")
        (let ((before (run-control)))
          (let ((measurement (run-profile quantum)))
            (let ((after (run-control)) (metrics (get measurement 'metrics)))
              (let ((reason (replay-refusal (get measurement 'value) metrics before after)))
                (let ((receipt (dict 'passed (= reason nil)
                                 'reason (if reason reason "recorded bytes match; fewer service calls and lower elapsed time")
                                 'quantum quantum 'metrics metrics 'control-before before 'control-after after
                                 'active (evolution-current policy-versions 'cell 'service-quantum))))
                  (console-log (text-concat "native-opt: probe " (print-form receipt)))
                  receipt)))))))))
(def worker (make-repair-agent "service-optimizer"
  (dict 'versions policy-versions 'tool 'service-quantum 'before-text "(fn (limit) 64)"
    'context (text-concat "Optimize the live encoder's service cadence. The fixed 64-byte policy incurs one acknowledged service call per chunk. Explain how your proposed function uses the controller's independently measured safe bound to increase the chunk size and how it rounds down without exceeding that bound. Cite the observed bytes, call count and bound in the diagnosis. Agel uses integer division for integer operands; local bindings use (let ((name value)) body). Write a pure function of one integer limit (64..4096) returning the largest multiple of 64 at or below limit. Activation requires exact recorded bytes, work and gap budgets, fewer calls and lower elapsed time than the control immediately before and after the candidate. Displayed probes: (64) -> 64, (192) -> 192. Observed timings are in microseconds: "
      (print-form observation))
    'examples (list (dict 'arguments '(64) 'expected 64) (dict 'arguments '(192) 'expected 192))
    'held-out (list (dict 'arguments '(65) 'expected 64) (dict 'arguments '(255) 'expected 192)
      (dict 'arguments '(511) 'expected 448) (dict 'arguments '(4096) 'expected 4096))
    'max-attempts 2 'threshold 800 'proposal-provider 'writer 'judge-provider 'judge
    'model-dispatch 'external 'defer-activation #t 'probe probe) nil))
(def retained-owner (get stream 'owner))
(send worker '(repair/start)) (run 1)
(def session (repair-agent-drive worker infer audit 6))
(def policy-activated (= (get session 'status) 'done))
(def policy-versions (get session 'versions))
(refresh-encoder)
(check (= (evolution-source policy-versions 1) initial-policy) "frozen policy source was lost")
(check (= retained-owner (get stream 'owner)) "stream owner changed")
(audit (dict 'event 'live-policy-versions 'versions policy-versions))
(if policy-activated
  (begin
    (check (= (evolution-current policy-versions 'cell 'service-quantum) 2) "policy version did not change")
    (check (< 64 (retained-quantum observed-length)) "retained encoder did not use the changed policy")
    (console-log (text-concat "native-opt: candidate " (print-form (get session 'candidate))))
    (console-log "native-opt: policy committed after text judgment and measured replay"))
  (begin
    (console-log (text-concat "native-opt: last refusal " (get session 'reason)))
    (check (if continue-after-refusal (= (get session 'status) 'exhausted) #f)
      "policy optimization did not activate")
    (check (= (evolution-current policy-versions 'cell 'service-quantum) 1) "refusal changed the active policy")
    (check (= (retained-quantum observed-length) 64) "refusal changed the encoder cadence")
    (console-log "native-opt: continued with fixed policy after exhausted retries")))
