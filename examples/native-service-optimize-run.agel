(def optimizer-started (clock-us))
(check recorded-field "no suitably sized recorded byte field")
(def recorded-hex (get (get recorded-field 'bytes) 'data))
(def recorded-hex-length (text-bytes recorded-hex))
(def observed-length (/ recorded-hex-length 2))
(check (replay-size? observed-length) "no suitably sized recorded workload")
(def require-optimization
  (fn ()
    (if (optimization-needed?) nil
      (signal 'native/optimization-complete "task completed during optimizer preparation"))))
(def next-preparation-observation optimizer-started)
(def prepare-service
  (fn ()
    ((get stream 'pulse))
    (let ((now (clock-us)))
      (if (< now next-preparation-observation) nil
        (begin
          (preparation-observe)
          (require-optimization)
          (def next-preparation-observation (+ (clock-us) 3000000)))))))
(prepare-service)
(def replay-chunks
  (fn (at chunks)
    (if (= at recorded-hex-length) chunks
      (let ((end (if (< (+ at 256) recorded-hex-length) (+ at 256) recorded-hex-length)))
        (let ((chunk (bytes-from-compact-hex (text-slice recorded-hex at end))))
          (prepare-service)
          (replay-chunks end (cons chunk chunks)))))))
(def replay-bytes
  (foldl (fn (body chunk)
           (prepare-service)
           (append chunk body))
    nil (replay-chunks 0 nil)))
(def run-profile
  (fn (quantum)
    (profile-work (fn (service) (bytes-hex-quantum replay-bytes service quantum))
      (get stream 'pulse) clock-us)))
(def control-quantum (retained-quantum observed-length))
(def run-control
  (fn ()
    (let ((measurement (run-profile control-quantum)))
      (check (= (get measurement 'value) recorded-hex) "control bytes differ from recorded input")
      (get measurement 'metrics))))
(def baseline (run-control))
(prepare-service)
(require-optimization)
(def work-budget 3000000)
(def gap-budget 6000000)
(def policy-bound (profile-limit baseline 64 work-budget 4 512))
(def observation (dict 'bytes observed-length 'baseline baseline 'bound policy-bound
  'work-budget-us work-budget 'gap-budget-us gap-budget 'margin 4 'record (get recorded-field 'name)))
(audit (dict 'event 'runtime-observation 'profile observation))
(console-log (text-concat "native-opt: observation " (print-form observation)))
(check (< 127 policy-bound) "recorded work profile does not justify a larger quantum")
(def replay-tape (text-concat (print-form (list 'recorded-workload observed-length recorded-hex)) "\n"))
(def tape-offset (text-bytes (file-read "judge-log")))
(def tape-length (text-bytes replay-tape))
(def append-tape
  (fn (at)
    (if (= at tape-length) #t
      (let ((end (if (< (+ at 2048) tape-length) (+ at 2048) tape-length)))
        (begin
          (prepare-service)
          (file-append "judge-log" (text-slice replay-tape at end))
          (append-tape end))))))
(append-tape 0)
(def speed-check
  (fn (quantum metrics before after)
    (let ((elapsed (get metrics 'elapsed-us))
          (first (get before 'elapsed-us)) (last (get after 'elapsed-us)))
      (if (if (< elapsed first) (< elapsed last) #f) nil
        (text-concat "candidate did not beat both adjacent controls: "
          (print-form (dict 'quantum quantum 'candidate-us elapsed 'before-us first 'after-us last
            'candidate-calls (get metrics 'calls) 'control-calls (get before 'calls))))))))
(def replay-refusal
  (fn (quantum value metrics before after)
    (if (= value recorded-hex)
      (if (< work-budget (get metrics 'work-max-us)) "candidate exceeded the measured work budget"
        (if (< gap-budget (get metrics 'gap-max-us)) "candidate exceeded the measured service gap budget"
          (if (< (get metrics 'calls) (get before 'calls))
            (speed-check quantum metrics before after) "candidate replay did not reduce service calls")))
      "candidate replay changed recorded bytes")))
(def probe
  (fn (state)
    (let ((candidate (meta-eval (get (get state 'candidate) 'after) (meta-base-env))))
      (let ((quantum (check-quantum (meta-apply candidate (list policy-bound)) policy-bound)))
        (check (< 64 quantum) "candidate selected the frozen cadence")
        (let ((before (run-control)))
          (let ((measurement (run-profile quantum)))
            (let ((after (run-control)) (metrics (get measurement 'metrics)))
              (let ((reason (replay-refusal quantum (get measurement 'value) metrics before after)))
                (let ((receipt (dict 'passed (= reason nil)
                                 'reason (if reason reason "recorded bytes match; fewer service calls and lower elapsed time")
                                 'quantum quantum 'metrics metrics 'control-before before 'control-after after
                                 'active (evolution-current policy-versions 'cell 'service-quantum))))
                  (console-log (text-concat "native-opt: probe " (print-form receipt)))
                  receipt)))))))))
(def max-measured-quantum (* 64 (/ policy-bound 64)))
(def projection
  (dict 'max-quantum-at-measured-bound max-measured-quantum
        'calls-at-max-quantum (/ (+ observed-length (- max-measured-quantum 1)) max-measured-quantum)))
(def worker (make-repair-agent "service-optimizer"
  (dict 'versions policy-versions 'tool 'service-quantum 'before-text "(fn (limit) 64)"
    'context (text-concat "The tool is a pure function from an integer limit (64 through 4096) to an integer cadence. The result must be a multiple of 64 between 64 and limit inclusive. The old policy always returns 64 and makes one acknowledged service call per 64 bytes. For this optimization, use the largest multiple of 64 at or below limit, optionally clamped to a constant cap that is a multiple of 64 and at least 128. If you choose a cap, pick one between 128 and max-quantum-at-measured-bound inclusive. The two displayed prediction inputs are 64 and 128, in that order. Return exactly two predictions. In the diagnosis, state what the function returns at the observed bound and the projected call count for that cadence on the recorded byte length. Use ceiling(bytes / cadence). The projection below is for the maximum cadence at the measured bound, so recompute if you choose a smaller one. Replay, after text approval, measures exact byte preservation, work and gap budgets, and whether the candidate beats both neighboring controls in elapsed time and makes fewer calls. If elapsed-time replay refused a prior candidate, use its measured quantum and call counts to choose a different legal cadence when one exists. Observed timings are in microseconds: "
      (text-concat (print-form observation) (text-concat "\nCadence projection: " (print-form projection))))
    'examples (list (dict 'arguments '(64) 'expected 64) (dict 'arguments '(128) 'expected 128))
    'held-out (list (dict 'arguments '(65) 'expected 64) (dict 'arguments '(191) 'expected 128))
    'max-attempts 2 'threshold 800 'proposal-provider 'writer 'judge-provider 'judge
    'model-dispatch 'external 'defer-activation #t 'probe probe) nil))
(def retained-owner (get stream 'owner))
(prepare-service)
(require-optimization)
(send worker '(repair/start)) (run 1)
(def session (repair-agent-drive-while worker infer audit 6 (fn (_) (optimization-needed?))))
(if (= (get session 'status) 'stopped)
  (signal 'native/optimization-complete "task completed after optimizer started" 'after-start)
  nil)
(map (fn (event)
  (if (= (get event 'event) 'refused)
    (begin
      (audit (assoc event 'event 'optimizer-refusal))
      (console-log (text-concat "native-opt: attempt refused: " (get event 'reason))))
    nil)) (get session 'history))
(def policy-activated (= (get session 'status) 'done))
(def policy-versions (get session 'versions))
(refresh-encoder)
(check (= (evolution-source policy-versions 1) initial-policy) "frozen policy source was lost")
(check (= retained-owner (get stream 'owner)) "stream owner changed")
(audit (dict 'event 'live-policy-versions 'versions policy-versions))
(def optimizer-elapsed (- (clock-us) optimizer-started))
(console-log (text-concat "native-opt: task-us " (print-form optimizer-elapsed)))
(if policy-activated
  (begin
    (check (= (evolution-current policy-versions 'cell 'service-quantum) 2) "policy version did not change")
    (check (< 64 (retained-quantum observed-length)) "retained encoder did not use the changed policy")
    (console-log (text-concat "native-opt: candidate " (print-form (get session 'candidate))))
    (console-log "native-opt: policy committed after text judgment and measured replay")
    (let ((probe (get (get (get (get policy-versions 'versions) 2) 'activation) 'probe)))
      (let ((estimate (profile-break-even optimizer-elapsed
                       (get (get probe 'control-before) 'elapsed-us)
                       (get (get probe 'control-after) 'elapsed-us)
                       (get (get probe 'metrics) 'elapsed-us))))
        (audit (dict 'event 'optimizer-break-even 'estimate estimate))
        (console-log (text-concat "native-opt: replay break-even " (print-form estimate))))))
  (begin
    (console-log (text-concat "native-opt: last refusal " (get session 'reason)))
    (check (if continue-after-refusal (= (get session 'status) 'exhausted) #f)
      "policy optimization did not activate")
    (check (= (evolution-current policy-versions 'cell 'service-quantum) 1) "refusal changed the active policy")
    (check (= (retained-quantum observed-length) 64) "refusal changed the encoder cadence")
    (console-log "native-opt: continued with fixed policy after exhausted retries")))
