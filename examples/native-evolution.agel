(import agel/native-program)
(import agel/sequence)
(import agel/program-store)
(import agel/evolution)
(import agel/judge-log)
(def check (fn (ok label) (if ok #t (signal 'native/test label))))
(def session-state (dict 'turns 7 'mailbox '(a b)))
(def judge-calls 0)
(def judge
  (fn (request)
    (begin
      (def judge-calls (+ judge-calls 1))
      (judge-with-log judge-calls request
        (fn (diff) (dict 'allowed #t 'reason "local native activation fixture" 'cost-microusd 0))
        (fn (record) (file-append "judge-log" (text-concat (print-form record) "\n")))))))
(def adapter (dict 'geometry (program-region) 'read program-sector-read
  'write program-sector-write 'flush program-flush 'run exec-canary 'prefix "v" 'fuel 1000000))
(def old '(fn (n) (+ n 1)))
(def new '(fn (n) (+ n 2)))
(def old-cases (list (dict 'arguments '(40) 'expected 41)))
(def new-cases (list (dict 'arguments '(40) 'expected 42)))
(def v1 (native-program-edit (evolution-new) 'worker nil old old-cases judge adapter))
(check (= (evolution-current v1 'program 'worker) 1) "initial native activation")
(check (= (native-program-run v1 'worker '(40) adapter) '(41 "41\n")) "initial execution")
(console-log "native-program: version 1 installed and executed in this OS")
(def v2 (native-program-edit v1 'worker old new new-cases judge adapter))
(check (= (evolution-current v2 'program 'worker) 2) "replacement activation")
(check (= (native-program-run v2 'worker '(40) adapter) '(42 "42\n")) "replacement execution")
(console-log "native-program: version 2 active; same Agel process and session")
(def replay-failed (native-program-edit v2 'worker new old new-cases judge adapter))
(check (= (evolution-current replay-failed 'program 'worker) 2) "replay rollback")
(def native-failed (native-program-edit replay-failed 'worker new '(fn (n) (+ n 3))
  (list (dict 'arguments '(40) 'expected 43)) judge (assoc adapter 'fuel 0)))
(check (= (evolution-current native-failed 'program 'worker) 2) "native canary rollback")
(check (= (native-program-run native-failed 'worker '(40) adapter) '(42 "42\n")) "native failure preserved active code")
(def restored (native-program-revert native-failed 'worker 1 old-cases judge adapter))
(check (= (evolution-current restored 'program 'worker) 3) "revert activation")
(check (= (native-program-run restored 'worker '(40) adapter) '(41 "41\n")) "revert execution")
(def domain-v1 (native-domain-edit restored 'worker nil old old-cases judge (assoc adapter 'prefix "d")))
(def domain-v2 (native-domain-edit domain-v1 'worker old new new-cases judge (assoc adapter 'prefix "d")))
(check (= (evolution-current domain-v2 'domain 'worker) 5) "domain generation did not activate")
(check (= (native-domain-run domain-v2 'worker '(40) adapter) '(42 "42\n")) "domain generation dispatch")
(check (= (native-program-run domain-v2 'worker '(40) adapter) '(41 "41\n")) "domain replaced a program")
(def domain-refused (native-domain-revert domain-v2 'worker 4 new-cases judge (assoc adapter 'prefix "d")))
(check (= (evolution-current domain-refused 'domain 'worker) 5) "domain revert bypassed replay")
(def domain-restored (native-domain-revert domain-refused 'worker 4 old-cases judge (assoc adapter 'prefix "d")))
(check (= (evolution-current domain-restored 'domain 'worker) 6) "domain revert did not activate")
(check (= (native-domain-run domain-restored 'worker '(40) adapter) '(41 "41\n")) "domain revert dispatch")
(check (= (evolution-source domain-restored 5) new) "prior domain generation was lost")
(console-log "native-domain: PASS: isolated generation dispatch, replay refusal, and guarded revert")
(check (= session-state (dict 'turns 7 'mailbox '(a b))) "session state changed")
(check (= judge-calls 9) "judge accounting")
(check (= (exec-canary "program-io-check") '(0 "no-files\n")) "canary file authority")
(def isolated (spawn "without-program-cap" (fn (self heap message) (program-sector-read 0)) nil nil))
(send isolated 'go)
(run 1)
(check (= (get (agent-info isolated) 'status) 'stopped) "program capability isolation")
(def failures (filter (fn (event) (= (get event 'kind) 'turn-failed)) (event-log)))
(check (= (get (get (car failures) 'detail) 'kind) 'capability/denied) "wrong isolated failure")
(console-log (file-read "judge-log"))
(console-log (text-concat "native-program: retained history " (print-form (get domain-restored 'history))))
(console-log "native-program: PASS: real ELF install, activation, canary rollback, revert, retained state and no-file canary")
#t
