     private fun reset(cheat: Cheat) = with(cheat) { player.setStatLevels(level = 1) }
 
+    @OptIn(InternalApi::class)
+    private fun setLevel(cheat: Cheat) = with(cheat) {
+        val requested = args.getOrNull(1)?.toIntOrNull()
+        if (args.size != 2 || requested == null || requested !in 1..99) {
+            player.mes("Usage: ::setlevel skill 1-99")
+            return@with
+        }
+        val key = "stat.${args[0].removePrefix("stat.")}"
+        val definition = ServerCacheManager.getStats().values.firstOrNull {
+            RSCM.getReverseMapping(RSCMType.STAT, it.id) == key
+        }
+        if (definition == null) {
+            player.mes("Unknown skill")
+            return@with
+        }
+        val target = max(definition.minLevel, requested)
+        val xp = PlayerSkillXPTable.getXPFromLevel(target)
+        if (player.statMap.getBaseLevel(key) > target) {
+            player.statRevert(key, target, xp)
+        } else {
+            val delta = xp - player.statMap.getXP(key)
+            player.statMap.setCurrentLevel(key, target.toByte())
+            player.statAdvance(key, delta.toDouble(), rate = 1.0, source = XpSource.Manual)
+        }
+        player.mes("${args[0]} set to $target")
+    }
+
