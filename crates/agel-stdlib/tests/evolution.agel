(import agel/evolution)
(import agel/sequence)
(import agel/meta)
(def check (fn (value) (if value #t (signal 'test/failed "evolution contract failed"))))
(def yes (fn (request) (dict 'allowed #t 'reason "within scope" 'cost-microusd 7)))
(def no (fn (request) (dict 'allowed #f 'reason "use addition" 'cost-microusd 3)))
(def cases (list (dict 'arguments '(20 22) 'expected 42)
                 (dict 'arguments '(0 0) 'expected 0)))
(def source '(fn (a b) (+ a b)))
(def initial (evolution-new))
(def first (evolution-edit initial 'cell 'tool nil source cases yes))
(check (= (evolution-current first 'cell 'tool) 1))
(check (= (count (get initial 'history)) 0))
(check (= (count (get first 'history)) 3))
(check (= (meta-apply (meta-eval (evolution-source first 1) (meta-base-env)) '(3 4)) 7))

; A plausible text approval cannot admit a behavioral regression.
(def bad (evolution-edit first 'cell 'tool source '(fn (a b) (- a b)) cases yes))
(check (= (evolution-current bad 'cell 'tool) 1))
(check (= (count (get bad 'history)) 6))
(check (= (count (get bad 'versions)) 1))
(check (= (get (evolution-cost bad) 'microusd) 14))
(def stale (evolution-edit bad 'cell 'tool nil source cases yes))
(check (= (get (evolution-cost stale) 'microusd) 14))
(check (= (count (get stale 'history)) 7))

; A rejected or throwing candidate leaves both active code and old evidence.
(def denied (evolution-edit first 'cell 'tool source source cases no))
(check (= (count (get denied 'history)) 5))
(check (= (evolution-current denied 'cell 'tool) 1))
(def crashed (evolution-edit first 'cell 'tool source '(fn (a b) (/ a 0)) cases yes))
(check (= (evolution-current crashed 'cell 'tool) 1))
(check (= (count (get crashed 'history)) 6))
(def empty (evolution-edit initial 'program 'empty nil source nil yes))
(check (= (evolution-current empty 'program 'empty) nil))
(def broken-judge (fn (request) (signal 'provider/down "provider unavailable")))
(def unavailable (evolution-edit initial 'cell 'x nil source cases broken-judge))
(check (= (get (evolution-cost unavailable) 'unknown) 1))
(check (= (count (get unavailable 'history)) 2))
(def malformed (evolution-edit initial 'cell 'x nil source cases (fn (request) nil)))
(check (= (evolution-current malformed 'cell 'x) nil))
(def no-reason (evolution-edit initial 'cell 'x nil source cases
                  (fn (request) (dict 'allowed #t 'cost-microusd 5))))
(check (= (evolution-current no-reason 'cell 'x) nil))
(check (= (get (evolution-cost no-reason) 'microusd) 5))
(check (= (get (evolution-replay '(fn () nil) (list (dict 'arguments nil))) 'passed) #f))
(def trapped (evolution-replay '(fn (n) (/ 12 n))
  (list (dict 'arguments '(3) 'expected 4) (dict 'arguments '(0) 'expected 0))))
(check (= (get trapped 'passed) #f))
(check (= (get trapped 'checked) 1))
(check (= (type-of (get trapped 'condition)) 'symbol))
(check (= (has-key? trapped 'arguments) #f))


; Retry reads the refusal reason and changes the candidate, within a bound.
(def repair
  (fn (state)
    (if (= (get state 'history) nil)
        '(fn (a b) (- a b))
        (begin
          (check (= (get (car (cdr (cdr (get state 'history)))) 'reason) "recorded step differs"))
          source))))
(def retried (evolution-retry initial 'program 'tool cases yes repair 2))
(check (= (evolution-current retried 'program 'tool) 1))
(check (= (get (evolution-cost retried) 'microusd) 14))
(check (= (count (get retried 'history)) 6))
(check (= (evolution-retry initial 'program 'tool cases yes repair 0) initial))
(def text-judge
  (fn (request)
    (if (= (get request 'after) source) (yes request) (no request))))
(def text-repair
  (fn (state)
    (if (= (get state 'history) nil) '(fn (a b) (- a b))
        (begin
          (check (= (get (car (cdr (get state 'history))) 'reason) "use addition"))
          source))))
(def text-retried (evolution-retry initial 'cell 'tool cases text-judge text-repair 2))
(check (= (evolution-current text-retried 'cell 'tool) 1))
(check (= (get (evolution-cost text-retried) 'microusd) 10))
(def exhausted (evolution-retry initial 'cell 'tool cases no (fn (state) source) 3))
(check (= (evolution-current exhausted 'cell 'tool) nil))
(check (= (count (get exhausted 'history)) 6))
(check (= (get (evolution-cost exhausted) 'microusd) 9))

; Live replacement is an explicit before/after code diff, not a mutable closure.
(def replacement '(fn (a b) (+ b a)))
(def second (evolution-edit first 'cell 'tool source replacement cases yes))
(check (= (evolution-current second 'cell 'tool) 2))
(def restored (evolution-revert second 'cell 'tool 1 cases yes))
(check (= (evolution-current restored 'cell 'tool) 3))
(check (= (evolution-source restored 3) source))
(check (= (evolution-source restored 2) replacement))
(check (= (count (get restored 'history)) 9))
(check (= (evolution-replay-version restored 1) (evolution-replay source cases)))
(check (= (get (evolution-replay-version restored 999) 'reason) "version does not exist"))
(def legacy (assoc first 'history (map (fn (event) (dissoc event 'cases)) (get first 'history))))
(check (evolution-valid? legacy))
(check (= (get (evolution-replay-version legacy 1) 'reason) "version has no retained replay corpus"))
(def wrong-object (evolution-revert restored 'program 'other 1 cases yes))
(check (= (evolution-current wrong-object 'program 'other) nil))
(def missing (evolution-revert restored 'cell 'tool 999 cases yes))
(check (= (evolution-current missing 'cell 'tool) 3))

(defmacro make-tool (operator) (fn (a b) (operator a b)))
(def macro-source (macroexpand-1 (make-tool +)))
(check (= (get (evolution-replay macro-source cases) 'passed) #t))
(def macro-version (evolution-edit initial 'program 'macro-tool nil macro-source cases yes))
(check (= (evolution-current macro-version 'program 'macro-tool) 1))

; Namespaces cannot alias cells, programs, domains or kernel-slot records.
(def domain (evolution-edit first 'domain 'tool nil source cases yes))
(def untested (evolution-edit domain 'kernel-slot 'tool nil source cases yes))
(check (= (evolution-current untested 'kernel-slot 'tool) nil))
(check (= (get (car (reverse (get untested 'history))) 'reason) "kernel slot requires a trial activation"))
(def trial (fn (request steps) (dict 'passed #t 'reason "trial fixture passed")))
(def kernel (evolution-edit-with-activation domain 'kernel-slot 'tool nil source cases yes trial))
(check (= (evolution-current kernel 'cell 'tool) 1))
(check (= (evolution-current kernel 'domain 'tool) 2))
(check (= (evolution-current kernel 'kernel-slot 'tool) 3))
(check (evolution-valid? kernel))
(def stripped (assoc (assoc kernel 'history
  (filter (fn (event) (if (= (get event 'event) 'activation) #f #t)) (get kernel 'history)))
  'versions (assoc (get kernel 'versions) 3 (dissoc (get (get kernel 'versions) 3) 'activation))))
(check (= (evolution-valid? stripped) #f))
(def changed-kernel (evolution-edit-with-activation kernel 'kernel-slot 'tool source replacement cases yes trial))
(def unsafe-kernel-revert (evolution-revert changed-kernel 'kernel-slot 'tool 3 cases yes))
(check (= (evolution-current unsafe-kernel-revert 'kernel-slot 'tool) 4))
(def failed-kernel-revert (evolution-revert-with-activation unsafe-kernel-revert 'kernel-slot 'tool 3 cases yes
  (fn (request steps) (dict 'passed #f 'reason "candidate failed trial"))))
(check (= (evolution-current failed-kernel-revert 'kernel-slot 'tool) 4))
(def restored-kernel (evolution-revert-with-activation failed-kernel-revert 'kernel-slot 'tool 3 cases yes trial))
(check (= (evolution-source restored-kernel 5) source))
(check (= (evolution-current restored-kernel 'kernel-slot 'tool) 5))
(check (evolution-valid? restored-kernel))
(check (= (evolution-replay-version restored-kernel 3) (evolution-replay source cases)))
(check (= (evolution-replay-version restored-kernel 5) (evolution-replay source cases)))
(def retried-kernel
  (evolution-retry-with-activation restored-kernel 'kernel-slot 'tool cases yes
    (fn (state)
      (if (= (get (car (reverse (get state 'history))) 'reason) "trial asked for old source")
        source replacement))
    2 (fn (request steps)
      (if (= (get request 'after) source) (trial request steps)
        (dict 'passed #f 'reason "trial asked for old source")))))
(check (= (evolution-source retried-kernel 6) source))
(check (= (evolution-current retried-kernel 'kernel-slot 'tool) 6))
(def activation-count 0)
(def activation (fn (request steps) (begin (def activation-count (+ activation-count 1))
  (dict 'passed #t 'reason "native artifact checked" 'artifact "program-v1"))))
(def gated (evolution-edit-with-activation initial 'program 'native nil source cases yes activation))
(check (= activation-count 1))
(check (= (get (get (get gated 'versions) 1) 'activation)
  (dict 'passed #t 'reason "native artifact checked" 'artifact "program-v1")))
(def refused-before-activation (evolution-edit-with-activation initial 'program 'native nil source cases no activation))
(def failed-before-activation (evolution-edit-with-activation initial 'program 'native nil '(fn (a b) (- a b)) cases yes activation))
(check (= activation-count 1))
(def absent-activation (evolution-edit-with-activation initial 'program 'native nil source cases yes (fn (request steps) nil)))
(check (= (evolution-current absent-activation 'program 'native) nil))
(def crashed-activation (evolution-edit-with-activation initial 'program 'native nil source cases yes
  (fn (request steps) (signal 'device/failed "staging device unavailable"))))
(check (= (evolution-current crashed-activation 'program 'native) nil))
(check (= (get (car (reverse (get crashed-activation 'history))) 'reason) "staging device unavailable"))
#t
