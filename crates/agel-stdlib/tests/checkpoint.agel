(import agel/bytes)
(import agel/data-codec)
(import agel/native-reader)
(import agel/checkpoint)
(def check (fn (ok label) (if ok #t (signal 'test/checkpoint label))))
(import agel/sequence)
(check (= (foldl (fn (a b) (signal 'test/empty "empty fold invoked callback")) 7 (keys (dict))) 7) "empty-list fold")
(check (= (map (fn (x) (signal 'test/empty "empty map invoked callback")) (list)) nil) "empty-list map")
(check (= (append (list) '(1 2)) '(1 2)) "empty-list append")
(check (= (text-crc32 "123456789") 3421780262) "standard CRC-32 check vector")
(check (= (text-crc32 "") 0) "empty CRC-32")
(check (= (text-crc32 "λ") (bytes-crc32 '(206 187))) "UTF-8 byte CRC parity")
(check (= (native-read "{version 2 source (fn (x) (+ x 1)) audit {reason \"brace } stays text\"}}" 200 8)
  (list (dict 'version 2 'source '(fn (x) (+ x 1)) 'audit (dict 'reason "brace } stays text"))))
  "printed audit map decodes as inert data")
(check (with-handler (reader/syntax problem) #t (begin (native-read "{x 1 x 2}" 20 4) #f))
  "duplicate audit key rejected")
(check (with-handler (reader/syntax problem) #t (begin (native-read "{x}" 20 4) #f))
  "incomplete audit map rejected")
(check (with-handler (reader/syntax problem) #t (begin (native-read "{x (1}" 20 4) #f))
  "mismatched map delimiter rejected")
(def original (dict 'source '(fn (x) (+ x 1)) 'nil nil 'empty (keys (dict)) 'empty-map (dict) 'false #f 'true #t
  'text "λ\n\"quoted\"" 'integer -9223372036854775808 'odd (text-symbol "a b()λ")))
(check (= (data-read (data-pack original render)) original) "inert roundtrip")
(check (with-handler (* problem) #t (begin (data-read "(l (unknown 1))") #f)) "unknown tag rejected")
(check (with-handler (* problem) #t (begin (data-read "(m (l (i 1) (i 2)) (l (i 1) (i 3)))") #f)) "duplicate key rejected")
(check (with-handler (* problem) #t (begin (data-pack + render) #f)) "executable value rejected")
(check (= (data-pack (keys (dict)) render) "(e)") "explicit empty-list encoding")
(check (= (data-read "(l)") (keys (dict))) "legacy empty-list syntax decodes faithfully")
(def current-data-read data-read)
(def current-data-pack data-pack)
(import agel/data-codec-v015)
(check (with-handler (* problem) #t (begin (data-read "(e)") #f)) "old reader refuses new empty-list tag")
(def data-read current-data-read)
(def data-pack current-data-pack)
(def validate (fn (state) (if (= (type-of state) 'map) (= (type-of (get state 'number)) 'int) #f)))
(def seed (dict 'number 0))
(def seed-store (checkpoint-new seed))
(def capture (fn (store state)
  (with-handler (* problem) (get problem 'message)
    (checkpoint-write store state render validate (fn (text) (signal 'capture text))))))
(def record1 (capture seed-store (dict 'number 1)))
(def committed1 (checkpoint-write seed-store (dict 'number 1) render validate (fn (text) (text-bytes text))))
(def record2 (capture committed1 (dict 'number 2)))
(def recovered (checkpoint-recover (text-concat record1 (text-concat "other judge bytes\n" record2)) seed validate))
(check (= (get recovered 'revision) 2) "complete commit chain recovered")
(check (= (get recovered 'state) (dict 'number 2)) "latest state selected")
(def torn (checkpoint-recover (text-concat record1 (text-slice record2 0 (- (text-bytes record2) 4))) seed validate))
(check (= (get torn 'state) (dict 'number 1)) "torn commit kept previous state")
(check (= (get torn 'issues) 1) "torn tail reported")
(def repaired (checkpoint-recover
  (text-concat record1 (text-concat "\nAGEL-STATE/1 0 (n)\n" record2)) seed validate))
(check (= (get repaired 'revision) 2) "valid successor survives damaged record")
(check (= (get repaired 'issues) 1) "checksum corruption reported")
(def duplicate (checkpoint-recover (text-concat record1 (text-concat record1 record2)) seed validate))
(check (= (get duplicate 'revision) 2) "duplicate did not fork chain")
(check (= (get duplicate 'issues) 1) "duplicate reported")
(def missing (checkpoint-recover record2 seed validate))
(check (= (get missing 'revision) 0) "missing predecessor refused")
(check (with-handler (* problem) #t
  (begin (checkpoint-write recovered (dict 'number 3) render validate (fn (text) 0)) #f)) "short append refuses publication")
(check (with-handler (* problem) #t
  (begin (checkpoint-write recovered (dict 'number "bad") render validate (fn (text) (text-bytes text))) #f)) "invalid state refused before append")
(import agel/evolution)
(check (evolution-valid? (evolution-new)) "empty version store validates")
(def versions (evolution-edit (evolution-new) 'cell 'step nil '(fn (n) (+ n 1))
  (list (dict 'arguments '(1) 'expected 2))
  (fn (request) (dict 'allowed #t 'reason "fixture" 'cost-microusd 0))))
(check (evolution-valid? versions) "valid version store")
(check (if (evolution-valid? (assoc versions 'next 3)) #f #t) "missing retained version rejected")
(check (if (evolution-valid? (assoc versions 'active (dict 'cell (dict 'other 1)))) #f #t) "foreign active pointer rejected")
(check (if (evolution-valid? (assoc versions 'history nil)) #f #t) "missing commit history rejected")
(check (= (data-read (data-pack versions render)) versions) "full version store roundtrip")
(import agel/live-runtime)
(def macro-old '(fn (parts) (cons 'begin parts)))
(def macro-new '(fn (parts) (list 'if (car parts) nil (cons 'begin (cdr parts)))))
(def judge (fn (request) (dict 'allowed #t 'reason "fixture" 'cost-microusd 0)))
(def macros (evolution-edit (evolution-new) 'cell 'unless nil macro-old
  (list (dict 'arguments '((#f 42)) 'expected '(begin #f 42))) judge))
(def repaired (runtime-edit (runtime-new macros) 'unless macro-old macro-new
  (list (dict 'arguments '((#f 42)) 'expected '(if #f nil (begin 42))))
  (list (dict 'expression '(unless #t (/ 1 0)) 'bindings (dict) 'expected nil)) judge))
(check (= (data-read (data-pack (get repaired 'versions) render)) (get repaired 'versions)) "runtime activation roundtrip")
#t
