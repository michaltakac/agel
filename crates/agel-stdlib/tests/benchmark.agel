(import agel/benchmark)
(def check (fn (ok message) (if ok #t (signal 'test/benchmark message))))
(def rejected (fn (action) (with-handler (benchmark/invalid problem) #t (begin (action) #f))))

(def shared (dict 'task 'coins 'server 'private 'initial-policy 1 'setup 'normal 'seed 42))
(def fixed (dict 'arm 'fixed 'comparison shared 'account 'control 'correct #t 'elapsed-us 500
  'coins-before 5 'coins-after 1005 'billing-complete #t 'charges nil))
(def adaptive (dict 'arm 'adaptive 'comparison shared 'account 'candidate 'correct #t 'elapsed-us 300
  'coins-before 0 'coins-after 2400 'billing-complete #t
  'charges (list (dict 'kind 'judge 'cost-nanousd 1000) (dict 'kind 'model 'cost-nanousd 2000))))
(def score (benchmark-pair fixed adaptive))
(check (= (get score 'elapsed-delta-us) -200) "time delta")
(check (= (get score 'cost-delta-nanousd) 3000) "cost delta")
(check (= (get (get score 'fixed) 'coins-per-dollar) nil) "zero-cost ratio must remain undefined")
(check (= (get (get score 'adaptive) 'coins-per-dollar) (dict 'coins 2400 'nanousd 3000)) "exact coin ratio")
(check (= (get (benchmark-run (assoc adaptive 'correct #f)) 'coins-per-dollar) nil) "failed task has no ratio")

(def unpriced (assoc adaptive 'charges (list (dict 'kind 'judge 'cost-nanousd 1000)
  (dict 'kind 'model 'cost-nanousd nil))))
(def unknown (benchmark-run unpriced))
(check (= (get unknown 'cost-nanousd) nil) "unknown must propagate to total")
(check (= (get (get unknown 'charges) 'judge-nanousd) 1000) "known judge cost must survive")
(check (= (get (get unknown 'charges) 'judge-calls) 1) "judge dispatch count")
(check (= (get (benchmark-pair fixed unpriced) 'cost-delta-nanousd) nil) "unknown must propagate to delta")
(check (= (get (benchmark-run (assoc fixed 'billing-complete #f)) 'cost-nanousd) nil) "incomplete coverage")
(check (rejected (fn () (benchmark-run (dissoc fixed 'charges)))) "missing charge observations")
(check (rejected (fn () (benchmark-pair fixed (assoc adaptive 'comparison (assoc shared 'seed 43))))) "different seeds")
(check (rejected (fn () (benchmark-pair fixed (assoc adaptive 'account 'control)))) "reused account")

(def saved (dict 'policy "v2" 'history "head-7"))
(def prior (assoc adaptive 'retained-state saved))
(def fresh (assoc (assoc (assoc adaptive 'fresh-account #t) 'account 'transfer) 'initial-state saved))
(check (= (benchmark-transfer prior fresh) (benchmark-run fresh)) "transfer with retained state")
(check (rejected (fn () (benchmark-transfer prior (assoc fresh 'account 'candidate)))) "transfer reused its account")
(check (rejected (fn () (benchmark-transfer prior (assoc fresh 'initial-state (dict 'policy "v1"))))) "transfer lost retained state")
(check (rejected (fn () (benchmark-transfer prior (dissoc fresh 'fresh-account)))) "transfer freshness unverified")
(check (= (benchmark-writer-usage (list (dict 'input 30 'cached-input 8 'output 12)
                                      nil (dict 'input 20 'cached-input nil 'output 4)))
          (dict 'calls 3 'metered 2 'cache-metered 1 'known-input 50 'known-cached-input 8 'known-output 16))
  "writer totals retain coverage of unavailable receipts and missing cache counts")
(check (rejected (fn () (benchmark-writer-usage (list (dict 'input 2 'cached-input 3 'output 4)))))
  "cached writer tokens must be a subset of input")
#t
