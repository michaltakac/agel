(import agel/live-tools)
(import agel/sequence)
(import agel/evolution)
(def check (fn (ok label) (if ok #t (signal 'test/failed label))))
(def receiver (spawn "tool-results"))
(def judge (fn (request) (dict 'allowed #t 'reason "fixture approval" 'cost-microusd 0)))
(def worker (live-tools "live-worker" judge))
(def old '(fn (observation) (get observation 'target)))
(def new '(fn (observation) (if (get observation 'ready) (get observation 'target) nil)))
(def ready (dict 'target 42 'ready #t))
(def pending (dict 'target 42 'ready #f))
(def old-cases (list (dict 'arguments (list ready) 'expected 42)))
(def new-cases (append old-cases (list (dict 'arguments (list pending) 'expected nil))))
(def edit
  (fn (before after cases)
    (send worker (dict 'operation 'edit 'name 'attack-target 'before before 'after after 'cases cases))))
(def call
  (fn (observation)
    (send worker (dict 'operation 'call 'name 'attack-target 'arguments (list observation) 'reply-to receiver))))
(edit nil old old-cases)
(call pending)
(edit old new new-cases)
(call pending)
(call ready)
(run 5)
(check (= (get (recv receiver) 'value) 42) "line 26")
(check (= (get (recv receiver) 'value) nil) "line 27")
(check (= (get (recv receiver) 'value) 42) "line 28")
(def state (live-tools-state worker))
(check (= (count (get state 'calls)) 3) "line 30")
(check (= (evolution-current (get state 'versions) 'cell 'attack-target) 2) "line 31")
; Stale edits, replay failures and failed calls preserve the running actor.
(edit old old old-cases)
(edit new old new-cases)
(call pending)
(send worker (dict 'operation 'call 'name 'missing 'arguments nil 'reply-to receiver))
(run 4)
(check (= (get (recv receiver) 'version) 2) "line 38")
(check (has-key? (recv receiver) 'error) "line 39")
(check (= (get (agent-info worker) 'status) 'running) "line 40")
; A revert cannot reinstate the unsafe behavior against the expanded corpus.
(send worker (dict 'operation 'revert 'name 'attack-target 'version 1 'cases new-cases))
(call pending)
(run 2)
(check (= (get (recv receiver) 'version) 2) "line 45")
; An equivalent macro-built implementation can be activated and reverted live.
(defmacro ready-tool () (fn (observation) (if (get observation 'ready) (let ((target (get observation 'target))) target) nil)))
(def generated (macroexpand-1 (ready-tool)))
(check (= (= generated new) #f) "macro produces a different implementation")
(edit new generated new-cases)
(run 1)
(send worker (dict 'operation 'revert 'name 'attack-target 'version 2 'cases new-cases))
(call pending)
(run 2)
(check (= (get (recv receiver) 'version) 4) "line 54")
(check (= (count (get (live-tools-state worker) 'calls)) 7) "line 55")
(check (= (evolution-source (get (live-tools-state worker) 'versions) 1) old) "line 56")
#t
