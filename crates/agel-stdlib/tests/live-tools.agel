(import agel/live-tools)
(import agel/sequence)
(import agel/evolution)
(def check (fn (ok label) (if ok #t (signal 'test/failed label))))
(def receiver (spawn "tool-results"))
(def judge (fn (request) (dict 'allowed #t 'reason "fixture approval" 'cost-microusd 0)))
(def worker (live-tools "live-worker" judge))
(def old '(fn (observation) (get observation 'target)))
(def new '(fn (observation) (if (get observation 'ready) (get observation 'target) nil)))
(def ready (dict 'target 42 'ready #t))
(def pending (dict 'target 42 'ready #f))
(def old-cases (list (dict 'arguments (list ready) 'expected 42)))
(def new-cases (append old-cases (list (dict 'arguments (list pending) 'expected nil))))
(def edit
  (fn (before after cases)
    (send worker (dict 'operation 'edit 'name 'attack-target 'before before 'after after 'cases cases))))
(def call
  (fn (observation)
    (send worker (dict 'operation 'call 'name 'attack-target 'arguments (list observation) 'reply-to receiver))))
(edit nil old old-cases)
(call pending)
(edit old new new-cases)
(call pending)
(call ready)
(run 5)
(check (= (get (recv receiver) 'value) 42) "line 26")
(check (= (get (recv receiver) 'value) nil) "line 27")
(check (= (get (recv receiver) 'value) 42) "line 28")
(def state (live-tools-state worker))
(check (= (count (get state 'calls)) 3) "line 30")
(check (= (evolution-current (get state 'versions) 'cell 'attack-target) 2) "line 31")
; Stale edits, replay failures and failed calls preserve the running actor.
(edit old old old-cases)
(edit new old new-cases)
(call pending)
(send worker (dict 'operation 'call 'name 'missing 'arguments nil 'reply-to receiver))
(run 4)
(check (= (get (recv receiver) 'version) 2) "line 38")
(check (has-key? (recv receiver) 'error) "line 39")
(check (= (get (agent-info worker) 'status) 'running) "line 40")
; A revert cannot reinstate the unsafe behavior against the expanded corpus.
(send worker (dict 'operation 'revert 'name 'attack-target 'version 1 'cases new-cases))
(call pending)
(run 2)
(check (= (get (recv receiver) 'version) 2) "line 45")
; An equivalent macro-built implementation can be activated and reverted live.
(defmacro ready-tool () (fn (observation) (if (get observation 'ready) (let ((target (get observation 'target))) target) nil)))
(def generated (macroexpand-1 (ready-tool)))
(check (= (= generated new) #f) "macro produces a different implementation")
(edit new generated new-cases)
(call ready)
(run 2)
(def generated-result (recv receiver))
(check (= (get generated-result 'version) 3) "dispatch the macro-built version")
(check (= (get generated-result 'value) 42) "macro-built tool returns the recorded result")
(send worker (dict 'operation 'revert 'name 'attack-target 'version 2 'cases new-cases))
(call pending)
(run 2)
(check (= (get (recv receiver) 'version) 4) "line 54")
(check (= (count (get (live-tools-state worker) 'calls)) 8) "retain calls through macro activation and revert")
(check (= (evolution-source (get (live-tools-state worker) 'versions) 1) old) "line 56")

(check (= (get (live-tools-inspect state 'web-search) 'available) #f) "unbound search is visible")
(check (= (get (live-tools-inspect state 'attack-target) 'source) new) "inspect active Agel source")
(check (= (count (live-tools-catalog state)) 4) "discover standard and custom tools")
(check (= (get (live-tools-context state) 'language) 'Agel) "publish agent-facing Agel context")
(def researcher
  (live-tools-with-research "researcher" judge
    (fn (query) (list (dict 'title query 'url "https://example.test/guide")))
    (fn (url) (dict 'kind 'html 'source url 'body "<title>Guide</title><p>Wait until ready.</p>"))))
(def research-call
  (fn (name arguments)
    (send researcher (dict 'operation 'call 'name name 'arguments arguments 'reply-to receiver))))
(research-call 'web-search '("readiness"))
(research-call 'web-read '("https://example.test/guide"))
(research-call 'evidence-ingest '(transcript "https://example.test/video#t=60" "Wait for the ready signal."))
(run 3)
(def hits (get (recv receiver) 'value))
(def page (get (recv receiver) 'value))
(def clip (get (recv receiver) 'value))
(check (= (get (car (get hits 'content)) 'url) (get page 'source)) "preserve retrieval provenance")
(check (= (get (get page 'content) 'title) "Guide") "read the Agel browser document")
(check (= (get clip 'trust) 'external) "external transcript is evidence")
(def extract '(fn (evidence) (get (get evidence 'content) 'title)))
(send researcher (dict 'operation 'edit 'name 'guide-title 'before nil 'after extract
                       'cases (list (dict 'arguments (list page) 'expected "Guide"))))
(research-call 'guide-title (list page))
(run 2)
(check (= (get (recv receiver) 'value) "Guide") "replay evidence and activate an Agel tool live")
(check (= (count (get (live-tools-state researcher) 'calls)) 4) "retain retrieval and custom tool calls")

(import agel/research)
(def chunks '((116 101 120 116 10 195) (169)))
(def closed 0)
(def fetch (research-stream-fetch (dict
  'open (fn () #t) 'close (fn () (def closed (+ closed 1)))
  'write (fn (bytes) (def sent bytes) (count bytes))
  'read (fn (_) (if chunks (let ((part (car chunks))) (def chunks (cdr chunks)) part) nil)))))
(check (= (get (fetch "https://a.test/") 'body) "é") "decode UTF-8 across transport chunks")
(check (= (car (reverse sent)) 10) "terminate relay request")
(check (= closed 1) "close relay after successful retrieval")
(def refused (with-handler (* problem) (get problem 'kind) (fetch "https://a.test/\n")))
(check (= refused 'research/input) "reject line injection before opening the relay")
(check (= closed 1) "invalid URL does not open the stream")
(def provider (research-query-provider
  (fn (url) (dict 'kind 'json 'source url 'body "[]"))
  "https://a.test/search?q=" "&limit=5"))
(def query-result ((get (get (research-tools provider nil) 'web-search) 'invoke) "é &"))
(def query-evidence (get query-result 'content))
(check (= (get query-evidence 'source) "https://a.test/search?q=%C3%A9%20%26&limit=5")
       "encode UTF-8 and protect query delimiters")
(check (= (get query-evidence 'trust) 'external) "mark query response as external")
(check (= (get query-evidence 'content) "[]") "retain the JSON response")
#t
