(import agel/byte-stream)
(def check (fn (ok label) (if ok #t (signal 'test/stream label))))
(def stream (byte-stream (fn (request)
  (if (= request "AGEL-BYTES/1 open") "ok"
  (if (= request "AGEL-BYTES/1 close") "ok"
  (if (= request "AGEL-BYTES/1 read-ready") "ok ready"
  (if (= request "AGEL-BYTES/1 read 256") "ok 00ff"
  (if (= request "AGEL-BYTES/1 entropy 3") "ok 000102"
  (if (= request "AGEL-BYTES/1 write 00ff0a80") "ok 4"
    (signal 'test/request "unexpected byte request"))))))))))
(check ((get stream 'open)) "open")
(check ((get stream 'read-ready)) "carrier readiness")
(check (= ((get stream 'read) 65536) '(0 255)) "bounded read")
(check (= ((get stream 'entropy) 3) '(0 1 2)) "entropy")
(check (= ((get stream 'write) '(0 255 10 128)) 4) "raw write")
(check (= ((get stream 'write) nil) 0) "empty write")
(check ((get stream 'close)) "close")
(check (with-handler (* problem) #t (begin ((get stream 'write) '(256)) #f)) "invalid byte")
(check (with-handler (* problem) #t (begin ((get stream 'read) 0) #f)) "zero count")
(def short (byte-stream (fn (request) "ok 00")))
(check (with-handler (* problem) #t (begin ((get short 'entropy) 2) #f)) "short entropy")
(def oversized (byte-stream (fn (_) "ok 001122")))
(check (= (with-handler (* problem) (get problem 'message) ((get oversized 'read) 2))
  "oversized byte reply") "bound carrier payload before decoding")
(def malformed-hex (byte-stream (fn (_) "ok 0 ")))
(check (= (with-handler (* problem) (get problem 'kind) ((get malformed-hex 'read) 2))
  'bytes/hex) "carrier replies require compact hex")
(def broken (byte-stream (fn (request) "garbage")))
(check (with-handler (* problem) #t (begin ((get broken 'open)) #f)) "malformed reply")
#t
(def zeros (fn (self n out) (if (= n 0) out (self self (- n 1) (cons 0 out)))))
(def never-write (byte-stream (fn (request) (signal 'test/io "must not send invalid input"))))
(check (= (with-handler (* problem) (get problem 'message)
  ((get never-write 'write) (zeros zeros 256 '(256)))) "expected byte") "validate full write before sending")
#t

(import agel/buffered-stream)
(def buffered (buffered-stream (dict
  'open (fn () #t) 'close (fn () #t) 'read (fn (n) '(1 2 3 4 5 6))
  'write (fn (bytes) (count bytes)) 'entropy (fn (n) nil)) 6 nil))
((get buffered 'open))
(check (with-handler (* problem) #t (begin ((get buffered 'read) 0) #f)) "invalid buffered read is rejected before state changes")
(check (= ((get buffered 'read-ready)) #f) "no readiness source before refill")
(check (= ((get buffered 'read) 1) '(1)) "first buffered byte")
(check ((get buffered 'read-ready)) "buffered bytes are ready without carrier I/O")
(check (= ((get buffered 'read) 2) '(2 3)) "buffer preserved across calls")
(check (= ((get buffered 'read) 8) '(4 5 6)) "partial buffered read")
(check (= (get (get ((get buffered 'info)) 'state) 'reads) 1) "one underlying read")
(check (= ((get buffered 'read) 1) '(1)) "buffer refilled")
((get buffered 'close))
((get buffered 'open))
(check (= ((get buffered 'read) 1) '(1)) "new connection resets old bytes")
#t
((get buffered 'close))
((get buffered 'open))
((get buffered 'start-service) (fn (n) (dict 'state (+ n 1) 'bytes '(9))) 0)
((get buffered 'read) 1)
((get buffered 'read) 1)
((get buffered 'read) 8)
((get buffered 'read) 1)
(check (= ((get buffered 'stop-service)) 2) "service runs only before physical refills")
#t
(def ended (buffered-stream (dict 'open (fn () #t) 'close (fn () #t)
  'write (fn (bytes) (count bytes)) 'read (fn (n) nil)) 6 nil))
((get ended 'open))
(check (= ((get ended 'read) 1) nil) "buffered EOF")
(check (= ((get ended 'read) 1) nil) "EOF stays latched")
(check (= (get (get ((get ended 'info)) 'state) 'reads) 1) "EOF does not refetch")
(def failing (buffered-stream (dict 'open (fn () #t) 'close (fn () #t)
  'write (fn (bytes) (count bytes)) 'read (fn (n) (signal 'test/io "read failed"))) 6 nil))
((get failing 'open))
((get failing 'start-service) (fn (n) (dict 'state (+ n 1) 'bytes '(9))) 0)
(check (= (with-handler (* problem) (get problem 'message) ((get failing 'read) 1)) "read failed") "read error surfaced")
(check (= ((get failing 'stop-service)) 1) "acknowledged service state survives read failure")
(check (= (with-handler (* problem) (get problem 'kind) ((get failing 'read) 1)) 'stream/failed) "failed stream cannot silently retry")
((get failing 'close))
((get failing 'open))
#t
((get buffered 'start-service) (fn (n) (dict 'state (+ n 1) 'bytes '(9))) 12)
((get buffered 'pulse))
((get buffered 'pulse))
(check (= ((get buffered 'stop-service)) 14) "explicit service pulses are Agel-owned")
#t

(import agel/bytes)
(def original (dict 'tag 'observation 'bytes '(0 255 10 128)))
(check (= (bytes-unpack-field (bytes-pack-field original 'bytes) 'bytes) original) "packed observation is lossless")
(check (= (bytes-unpack-field original 'bytes) original) "legacy observation remains readable")
(check (= (get (bytes-unpack-field (bytes-pack-field (dict 'bytes (keys (dict))) 'bytes) 'bytes) 'bytes) (keys (dict))) "packed empty list stays distinct from nil")
(check (= (get (bytes-unpack-field (bytes-pack-field (dict 'bytes nil) 'bytes) 'bytes) 'bytes) nil) "packed nil stays nil")
(check (with-handler (* problem) #t (begin (bytes-unpack-field (dict 'bytes (dict 'encoding 'hex 'nil? #t 'data "01")) 'bytes) #f)) "invalid packed nil rejected")
#t
(def malformed-read (buffered-stream (dict 'read (fn (_) '(1 256))) 2 nil))
(check (= (with-handler (* problem) (get problem 'message) ((get malformed-read 'read) 1))
  "expected byte") "invalid unread bytes refuse the entire refill")
(check (= (with-handler (* problem) (get problem 'kind) ((get malformed-read 'read) 1))
  'stream/failed) "invalid refill latches failure")
