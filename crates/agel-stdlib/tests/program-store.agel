(import agel/bytes)
(import agel/program-store)
(import agel/native-program)
(import agel/evolution)
(import agel/sequence)
(def check (fn (value label) (if value #t (signal 'test/failed label))))
(check (= (bytes-crc32 nil) 0) "line 7")
(check (= (bytes-crc32 (bytes-from-hex "313233343536373839")) 3421780262) "line 8")
(check (= (bytes-from-hex "aAFF00") '(170 255 0)) "line 9")
(def zeros (fn (n out) (if (= n 0) out (zeros (- n 1) (cons 0 out)))))
(def table-bytes (append '(65 71 69 76 80 82 49 0) (zeros 504 nil)))
(def disk (dict 0 table-bytes))
(def events nil)
(def read (fn (sector) (get disk sector)))
(def write (fn (sector bytes) (begin (def disk (assoc disk sector bytes)) (def events (append events (list sector))) 0)))
(def flush (fn () (begin (def events (append events '(flush))) 0)))
(def installed (program-install-hex '(2048 8192) "probe1" "313233343536373839" read write flush))
(check (= (get installed 'crc) 3421780262) "line 18")
(check (= events '(1 flush 0 flush)) "line 19")
(check (= (get (get (program-table '(2048 8192) (read 0)) 'entries) "probe1")
          (dict 'start 2049 'length 9 'crc 3421780262 'end 2050)) "line 20")
(def repeated (with-handler (* e) (get e 'message)
  (program-install-hex '(2048 8192) "probe1" "00" read write flush)))
(check (= repeated "program already exists; retain versions under distinct names") "line 24")
(check (= events '(1 flush 0 flush)) "line 25")
(def judge (fn (request) (dict 'allowed #t 'reason "fixture approval" 'cost-microusd 0)))
(def result '(41 "41\n"))
(def adapter (dict 'geometry '(2048 8192) 'read read 'write write 'flush flush 'prefix "p" 'fuel 1000000 'run (fn (name) result)))
(def old '(fn (n) (+ n 1)))
(def newer '(fn (n) (+ n 2)))
(def old-cases (list (dict 'arguments '(40) 'expected 41)))
(def new-cases (list (dict 'arguments '(40) 'expected 42)))
(def v1 (native-program-edit (evolution-new) 'worker nil old old-cases judge adapter))
(if (= (evolution-current v1 'program 'worker) 1) #t (signal 'test/failed "native initial activation" (get v1 'history)))
(def result '(42 "42\n"))
(def v2 (native-program-edit v1 'worker old newer new-cases judge adapter))
(check (= (evolution-current v2 'program 'worker) 2) "line 37")
(check (= (native-program-run v2 'worker '(40) adapter) '(42 "42\n")) "activated artifact runs")
(def rewrite-byte
  (fn (bytes index)
    (if (= index 0)
      (cons (if (= (car bytes) 0) 1 0) (cdr bytes))
      (cons (car bytes) (rewrite-byte (cdr bytes) (- index 1))))))
(def retargeted (assoc (assoc adapter 'read (fn (_) (rewrite-byte (read 0) 104)))
  'run (fn (_) (signal 'test/failed "retargeted image was dispatched"))))
(check (= (with-handler (program/activation e) (get e 'message)
  (native-program-run v2 'worker '(40) retargeted))
  "installed program differs from the activated artifact") "changed program CRC refused")
(def result '(43 "different\n"))
(def failed (native-program-edit v2 'worker newer '(fn (n) (+ n 3))
  (list (dict 'arguments '(40) 'expected 43)) judge adapter))
(check (= (evolution-current failed 'program 'worker) 2) "line 42")
(check (= (get (car (reverse (get failed 'history))) 'reason) "compiled canary differs") "line 43")
(def result '(41 "41\n"))
(def restored (native-program-revert failed 'worker 1 old-cases judge adapter))
(check (= (evolution-current restored 'program 'worker) 3) "line 46")
(check (= (evolution-source restored 3) old) "line 47")
(check (= (count (get (program-table '(2048 8192) (read 0)) 'entries)) 5) "line 48")
(def snapshot (read 0))
(def invalid-name (with-handler (* e) (get e 'message)
  (program-install-hex '(2048 8192) (text-from-bytes '(120 0)) "00" read write flush)))
(check (= invalid-name "invalid program name") "embedded NUL rejected")
(def io-failed (with-handler (* e) (get e 'message)
  (program-install-hex '(2048 8192) "failed-io" "00" read (fn (sector bytes) -5) flush)))
(check (= io-failed "program sector write failed") "write failure before publication")
(check (= snapshot (read 0)) "failed install preserved program table")
(def reads 0)
(def stale-read (fn (sector) (begin (def reads (+ reads 1))
  (if (= reads 1) snapshot (cons 0 (cdr snapshot))))))
(def stale (with-handler (* e) (get e 'message)
  (program-install-hex '(2048 8192) "stale" "00" stale-read write flush)))
(check (= stale "program table changed while staging") "stale table rejected")
(check (= snapshot (read 0)) "stale install preserved program table")
(each (fn (name) (program-install-hex '(2048 8192) name "00" read write flush))
  '("full0" "full1" "full2" "full3" "full4" "full5" "full6" "full7" "full8" "full9"))
(def full (read 0))
(def exhausted (with-handler (* e) (get e 'message)
  (program-install-hex '(2048 8192) "full10" "00" read write flush)))
(check (= exhausted "program table full") "full table refuses without replacing old versions")
(check (= full (read 0)) "full table preserved")
#t
