(module agel/program-store
  (import agel/sequence)
  (import agel/bytes)
  (export program-table program-install-hex)
  (def require (fn (ok reason) (if ok #t (signal 'program/store reason))))
  (def rem (fn (a b) (- a (* b (/ a b)))))
  (def drop (fn (xs n) (if (= n 0) xs (drop (cdr xs) (- n 1)))))
  (def take-into (fn (xs n out) (if (= n 0) (reverse out) (take-into (cdr xs) (- n 1) (cons (car xs) out)))))
  (def take (fn (xs n) (take-into xs n nil)))
  (def zeros (fn (n out) (if (= n 0) out (zeros (- n 1) (cons 0 out)))))
  (def join (fn (left right) (foldl (fn (out byte) (cons byte out)) right (reverse left))))
  (def le32 (fn (n) (list (rem n 256) (rem (/ n 256) 256) (rem (/ n 65536) 256) (/ n 16777216))))
  (def uint (fn (bytes) (+ (car bytes) (* 256 (car (cdr bytes))) (* 65536 (car (cdr (cdr bytes)))) (* 16777216 (car (cdr (cdr (cdr bytes))))))))
  (def name-bytes
    (fn (bytes out)
      (if (= bytes nil) (reverse out)
        (if (= (car bytes) 0) (begin (require (= (foldl + 0 bytes) 0) "nonzero name padding") (reverse out))
          (begin (require (if (< 32 (car bytes)) (< (car bytes) 127) #f) "invalid program name")
            (name-bytes (cdr bytes) (cons (car bytes) out)))))))
  (def rows
    (fn (bytes remaining base sectors entries end)
      (if (= remaining 0) (dict 'entries entries 'end end)
        (let ((name (text-from-bytes (name-bytes (take bytes 16) nil)))
              (start (uint (drop bytes 16))) (length (uint (drop bytes 20)))
              (crc (uint (drop bytes 24))))
          (let ((finish (+ start (/ (+ length 511) 512))))
            (begin
              (require (< 0 (text-bytes name)) "empty program name")
              (require (if (has-key? entries name) #f #t) "duplicate program name")
              (require (if (< base start) (if (< 0 length) (if (< (+ base sectors) finish) #f #t) #f) #f) "program outside region")
              (if (= (count entries) 0) #t (foldl (fn (_ other)
                (let ((entry (get entries other)))
                  (require (if (< start (get entry 'end)) (if (< (get entry 'start) finish) #f #t) #t) "overlapping programs"))) #t (keys entries)))
              (rows (drop bytes 32) (- remaining 1) base sectors
                (assoc entries name (dict 'start start 'length length 'crc crc 'end finish))
                (if (< end finish) finish end))))))))
  (def program-table
    (fn (geometry bytes)
      (begin
        (require (= (count geometry) 2) "expected region base and sector count")
        (require (if (= (type-of (car geometry)) 'int) (if (< -1 (car geometry)) (< (car geometry) 4294967296) #f) #f) "invalid region base")
        (require (if (= (type-of (car (cdr geometry))) 'int) (if (< 1 (car (cdr geometry))) (< (+ (car geometry) (car (cdr geometry))) 4294967297) #f) #f) "invalid region extent")
        (require (= (count bytes) 512) "table must be one sector")
        (foldl (fn (_ byte) (require (if (= (type-of byte) 'int) (if (< -1 byte) (< byte 256) #f) #f) "invalid table byte")) #t bytes)
        (require (= (take bytes 8) '(65 71 69 76 80 82 49 0)) "unknown program table")
        (let ((count (uint (drop bytes 8))))
          (begin (require (< count 16) "invalid table count")
            (assoc (assoc (rows (drop bytes 16) count (car geometry) (car (cdr geometry))
              (dict) (+ (car geometry) 1)) 'count count) 'bytes bytes))))))
  (def write-data
    (fn (write sector chunks)
      (if (= chunks nil) #t
        (let ((size (if (< (count chunks) 4) (count chunks) 4)))
          (let ((parts (map (fn (chunk) (join chunk (zeros (- 128 (count chunk)) nil))) (take chunks size))))
            (begin
              (require (= (write sector (join parts (zeros-parts (- 4 size) nil))) 0) "program sector write failed")
              (write-data write (+ sector 1) (drop chunks size))))))))
  (def zeros-parts (fn (n out) (if (= n 0) out (zeros-parts (- n 1) (cons (zeros 128 nil) out)))))
  (def program-install-hex
    (fn (geometry name hex read write flush)
      (let ((table (program-table geometry (read 0))) (chunks (bytes-hex-chunks hex 128)))
        (let ((start (get table 'end)) (length (foldl (fn (n chunk) (+ n (count chunk))) 0 chunks)))
          (begin
            (require (if (< 0 (text-bytes name)) (< (text-bytes name) 17) #f) "program name must be 1..16 bytes")
            (foldl (fn (_ byte) (require (if (< 32 byte) (< byte 127) #f) "invalid program name")) #t (text-bytes-list name))
            (require (if (has-key? (get table 'entries) name) #f #t) "program already exists; retain versions under distinct names")
            (require (< (get table 'count) 15) "program table full")
            (require (< 0 length) "empty program")
            (require (if (< (+ (car geometry) (car (cdr geometry))) (+ start (/ (+ length 511) 512))) #f #t) "program region full")
            (let ((crc (bytes-crc32-finish (foldl bytes-crc32-feed 4294967295 chunks))))
              (let ((row (join (join (text-bytes-list name) (zeros (- 16 (text-bytes name)) nil))
                           (join (le32 start) (join (le32 length) (join (le32 crc) '(0 0 0 0))))))
                    (old (get table 'bytes)) (offset (+ 16 (* 32 (get table 'count)))))
                (let ((next (join (take old 8) (join (le32 (+ (get table 'count) 1))
                              (join (take (drop old 12) (- offset 12)) (join row (drop old (+ offset 32))))))))
                  (begin
                    (write-data write (- start (car geometry)) chunks)
                    (require (= (flush) 0) "program data flush failed")
                    (require (= old (read 0)) "program table changed while staging")
                    (require (= (write 0 next) 0) "program table write failed")
                    (require (= (flush) 0) "program table flush failed")
                    (require (= next (read 0)) "program table publication uncertain")
                    (dict 'name name 'start start 'length length 'crc crc))))))))))
  (def text-bytes-loop
    (fn (text at out) (if (= at (text-bytes text)) (reverse out)
      (text-bytes-loop text (+ at 1) (cons (text-byte text at) out)))))
  (def text-bytes-list (fn (text) (text-bytes-loop text 0 nil))))
