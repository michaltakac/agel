(module agel/repair
  (import agel/sequence)
  (import agel/meta)
  (import agel/native-reader)
  (import agel/evolution)
  (import agel/live-tools)
  (import agel/judgment)
  (export make-repair-agent repair-state repair-prompt repair-evaluate)

  (def repair-state (fn (agent) (get (agent-info agent) 'heap)))
  (def nth (fn (values n) (if (= n 0) (car values) (nth (cdr values) (- n 1)))))
  (def note (fn (state event) (assoc state 'history (append (get state 'history) (list event)))))
  (def evaluate-cases
    (fn (candidate cases report)
      (if (= cases nil) report
          (let ((case (car cases)))
            (let ((result (with-handler (* problem) (dict 'error problem 'correct #f)
                            (let ((actual (meta-apply candidate (get case 'arguments))))
                              (dict 'actual actual 'correct (= actual (get case 'expected)))))))
              (evaluate-cases candidate (cdr cases)
                (assoc (assoc (assoc report 'total (+ (get report 'total) 1))
                  'correct (+ (get report 'correct) (if (get result 'correct) 1 0)))
                  'steps (append (get report 'steps) (list (dict 'case case 'result result))))))))))
  (def repair-evaluate
    (fn (state version)
      (let ((entry (get (get (get state 'versions) 'versions) version)))
        (if (if entry (if (= (get entry 'kind) 'cell) (= (get entry 'name) (get state 'tool)) #f) #f)
          (evaluate-cases (meta-eval (get entry 'source) (meta-base-env))
            (append (get state 'examples) (get state 'held-out))
            (dict 'version version 'total 0 'correct 0 'steps nil))
          (signal 'repair/version "version is not this tool")))))
  (def read-one
    (fn (text)
      (let ((forms (native-read text 8192 48)))
        (if (= (count forms) 1) (car forms)
            (signal 'repair/report "expected exactly one expression")))))
  (def repair-prompt
    (fn (state)
      (text-concat
        "Repair an Agel tool. Return exactly one expression, no markdown or tools: (dict 'diagnosis \"cause supported by observations\" 'after '(fn (...) ...) 'predictions (list ...)). Predictions are candidate outputs for the displayed probes in order. Use only fn, if, let, begin, quote and pure primitives + - * / = < list cons car cdr dict get assoc count has-key? type-of dissoc keys. Arithmetic is checked signed 64-bit; integer division truncates. The returned source is evaluated in a restricted metacircular environment. Preserve the full contract, not just displayed examples. After refusal, revise the rejected source using the reason.\nContract, observations, probes:\n"
        (text-concat (get state 'context)
          (text-concat "\nCurrent source:\n" (text-concat (get state 'before-text)
            (text-concat "\nPrevious refusal:\n" (text-concat (get state 'reason)
              (text-concat "\nPrevious report:\n" (get state 'previous-report))))))))))
  (def propose
    (fn (self state)
      (if (< 0 (get state 'remaining))
          (let ((prompt (repair-prompt state)))
            (let ((id (model-request (get state 'proposal-provider) prompt self)))
              (assoc (assoc (assoc (assoc
                (note state (dict 'event 'proposal-request 'id id 'prompt prompt 'cost-microusd nil))
                'status 'proposing) 'pending id) 'remaining (- (get state 'remaining) 1))
                'pending-provider (get state 'proposal-provider))))
          (assoc state 'status 'exhausted))))
  (def retry
    (fn (self state reason)
      (propose self (assoc (note state (dict 'event 'refused 'reason reason)) 'reason reason))))
  (def prediction-cases
    (fn (cases predictions)
      (if (= (count cases) (count predictions))
          (if (= cases nil) nil
              (cons (dict 'arguments (get (car cases) 'arguments) 'expected (car predictions))
                (prediction-cases (cdr cases) (cdr predictions))))
          (signal 'repair/prediction "prediction count differs from displayed probes"))))
  (def parse-report
    (fn (state text)
      (with-handler (* problem) (dict 'error (get problem 'message))
        (let ((report (meta-eval (read-one text) (meta-base-env))))
          (if (= (type-of report) 'map)
              (if (= (type-of (get report 'diagnosis)) 'string)
                  (if (< 0 (text-bytes (get report 'diagnosis)))
                      (let ((predictions (get report 'predictions)))
                        (if (if (= predictions nil) #t (= (type-of predictions) 'list))
                          (begin
                            (prediction-cases (get state 'examples) predictions)
                            report)
                          (dict 'error "predictions must be a list")))
                      (dict 'error "diagnosis is empty"))
                  (dict 'error "diagnosis must be text"))
              (dict 'error "report must be a map"))))))
  (def ask-judge
    (fn (self state report text)
      (let ((prompt (judgment-request
              (list (list "contract and observations" (get state 'context))
                    (list "before" (get state 'before-text)) (list "proposal" text))
              (list '(noul "patch" "Is this a legitimate, in-scope Agel repair proposal whose diagnosis addresses the observed failure? Behavioral correctness is checked separately by executable replay.")
                    '(choice "reason" "Which defect is directly evident in the proposal text? Use none when no defect is directly evident."
                      ("none" "No identified defect") ("contract" "Does not implement the contract")
                      ("boundary" "Fails at valid boundaries, types or integer limits")
                      ("syntax" "Invalid Agel or unsupported primitives")
                      ("effects" "Requires unavailable effects or authority"))))))
        (let ((id (model-request (get state 'judge-provider) prompt self)))
          (assoc (assoc (assoc (assoc
            (note state (dict 'event 'judge-request 'id id 'prompt prompt 'cost-microusd nil))
            'status 'judging) 'pending id) 'candidate report)
            'pending-provider (get state 'judge-provider))))))
  (def verdict
    (fn (state text)
      (with-handler (* problem)
        (dict 'allowed #f 'reason (get problem 'message) 'cost-microusd nil)
        (let ((answers (judgment-parse text)))
          (let ((result (answer answers "patch")) (reason (answer answers "reason")))
            (if (if (= (count answers) 2) (if result (if reason
                      (if (= (answer-kind result) 'noul) (= (answer-kind reason) 'choice) #f) #f) #f) #f)
              (let ((score (answer-value result)))
                (if (if (< -1 score) (< score 1001) #f)
                  (dict 'allowed (if (< score (get state 'threshold)) #f (= (answer-value reason) "none"))
                    'reason (text-concat "text judge returned: " text) 'score score
                    'reason-code (answer-value reason) 'cost-microusd nil)
                  (dict 'allowed #f 'reason "judge score outside 0..1000" 'cost-microusd nil)))
              (dict 'allowed #f 'reason "judge omitted the patch verdict" 'cost-microusd nil)))))))
  (def finish-judge
    (fn (self state text)
      (let ((receipt (verdict state text)) (before (read-one (get state 'before-text))))
        (let ((versions (evolution-edit (get state 'versions) 'cell (get state 'tool)
                before (get (get state 'candidate) 'after)
                (append (prediction-cases (get state 'examples) (get (get state 'candidate) 'predictions))
                  (append (get state 'examples) (get state 'held-out))) (fn (request) receipt))))
          (let ((next (assoc state 'versions versions)))
            (if (= (evolution-current versions 'cell (get state 'tool))
                   (evolution-current (get state 'versions) 'cell (get state 'tool)))
                (retry self next (get (car (reverse (get versions 'history))) 'reason))
                (assoc next 'status 'done)))))))
  (def result
    (fn (self state message)
      (if (if (= (nth message 1) (get state 'pending))
              (= (nth message 2) (get state 'pending-provider)) #f)
        (let ((next (note state (dict 'event 'model-result 'message message 'cost-microusd nil))))
          (if (= (car message) 'system/model-error)
              (retry self next (nth message 4))
              (if (= (get state 'status) 'proposing)
                  (let ((report (parse-report state (nth message 3))))
                    (if (get report 'error) (retry self next (get report 'error))
                        (ask-judge self (assoc next 'previous-report (nth message 3)) report (nth message 3))))
                  (if (= (get state 'status) 'judging) (finish-judge self next (nth message 3)) next))))
        state)))
  (def behavior
    (fn (self state message)
      (if (= (car message) 'repair/start)
          (if (= (get state 'status) 'idle) (propose self state) state)
          (if (= (car message) 'system/model-result) (result self state message)
              (if (= (car message) 'system/model-error) (result self state message)
                  (signal 'repair/message "unknown repair message"))))))
  (def make-repair-agent
    (fn (name options capabilities)
      (let ((before (read-one (get options 'before-text)))
            (versions (get options 'versions)) (threshold (get options 'threshold)))
        (if (if (= (type-of threshold) 'int) (if (< -1 threshold) (< threshold 1001) #f) #f)
          (if (= before (evolution-source versions (evolution-current versions 'cell (get options 'tool))))
            (spawn name behavior
              (assoc (assoc (assoc (assoc (assoc options 'status 'idle) 'history nil) 'reason "")
                'previous-report "") 'remaining (get options 'max-attempts)) nil nil 'stop 0 capabilities)
            (signal 'repair/base "source text does not match the active tool"))
          (signal 'repair/threshold "threshold must be in 0..1000"))))))
