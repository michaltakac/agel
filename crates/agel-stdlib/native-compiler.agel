; Closed frontend: all recursive helpers are explicitly self-applied. The same
; source is installed as a function and exposed as data for bootstrap checks.
(fn (source)
  (let ((primitives '(+ - * / = < list cons car cdr dict get assoc dissoc keys
                       count has-key? type-of apply signal))
        (fail (fn () (signal 'native/syntax "unsupported or malformed native source"))))
    (let ((member (fn (self x xs)
                    (if (= xs nil) #f
                        (if (= x (car xs)) #t (self self x (cdr xs)))))))
      (let ((parameters
              (fn (self xs seen)
                (if (= xs nil) nil
                    (if (= (type-of xs) 'list)
                        (if (= (type-of (car xs)) 'symbol)
                            (if (member member (car xs) seen) (fail)
                                (begin (self self (cdr xs) (cons (car xs) seen)) xs))
                            (fail))
                        (fail)))))
            (lookup
              (fn (self name frames depth)
                (if (= frames nil)
                    (if (member member name primitives) (list 'builtin name) (fail))
                    (let ((find (fn (self xs index found)
                                  (if (= xs nil) found
                                      (self self (cdr xs) (+ index 1)
                                        (if (= name (car xs)) index found))))))
                      (let ((index (find find (car frames) 0 nil)))
                        (if (= index nil) (self self name (cdr frames) (+ depth 1))
                            (list 'local depth index)))))))
            (bindings
              (fn (self xs)
                (if (= xs nil) (list nil nil)
                    (if (= (type-of xs) 'list)
                        (let ((pair (car xs)))
                          (if (= (type-of pair) 'list)
                              (if (= (count pair) 2)
                                  (if (= (type-of (car pair)) 'symbol)
                                      (let ((tail (self self (cdr xs))))
                                        (list (cons (car pair) (car tail))
                                          (cons (car (cdr pair)) (car (cdr tail)))))
                                      (fail))
                                  (fail))
                              (fail)))
                        (fail))))))
        (let ((walk
                (fn (self form frames tail-position)
                  (let ((many (fn (many xs env last-tail)
                                (if (= xs nil) nil
                                    (cons (self self (car xs) env
                                            (if (= (cdr xs) nil) last-tail #f))
                                      (many many (cdr xs) env last-tail))))))
                    (if (= (type-of form) 'symbol) (lookup lookup form frames 0)
                        (if (= (type-of form) 'list)
                            (let ((head (car form)) (tail (cdr form)))
                              (if (= head 'quote)
                                  (if (= (count tail) 1) (list 'const (car tail)) (fail))
                                  (if (= head 'if)
                                      (if (= (count tail) 3)
                                          (list 'if (self self (car tail) frames #f)
                                            (self self (car (cdr tail)) frames tail-position)
                                            (self self (car (cdr (cdr tail))) frames tail-position)) (fail))
                                      (if (= head 'fn)
                                          (if (< (count tail) 2) (fail)
                                              (let ((names (parameters parameters (car tail) nil)))
                                                (list 'fn (count names)
                                                  (cons 'begin
                                                    (many many (cdr tail) (cons names frames) #t)))))
                                          (if (= head 'let)
                                              (if (< (count tail) 2) (fail)
                                                  (let ((parts (bindings bindings (car tail))))
                                                    (list (if tail-position 'tail-call 'call)
                                                      (list 'fn (count (car parts))
                                                        (cons 'begin (many many (cdr tail)
                                                          (cons (car parts) frames) #t)))
                                                      (many many (car (cdr parts)) frames #f))))
                                              (if (= head 'begin)
                                                  (cons 'begin (many many tail frames tail-position))
                                                  (list (if tail-position 'tail-call 'call)
                                                    (self self head frames #f)
                                                    (many many tail frames #f))))))))
                            (list 'const form)))))))
          (if (= (type-of source) 'list)
              (if (= (car source) 'fn)
                  (list 'agel/native-v2 (walk walk source nil #f)) (fail))
              (fail)))))))
