; Closed static linker and restricted expression-template macro expander.
; Modules are ordered; only explicit exports may be imported. No compile-time eval.
(fn (modules entry-module entry-name)
  (let ((fail (fn () (signal 'native/modules "invalid module, import, binding or syntax template")))
        (primitives '(+ - * / = < list cons car cdr dict get assoc dissoc keys
                      count has-key? type-of apply signal text-bytes text-byte
                      text-slice text-concat text-symbol)))
    (let ((member (fn (self x xs)
                   (if (= xs nil) #f (if (= x (car xs)) #t (self self x (cdr xs))))))
          (nth (fn (xs n) (if (= n 0) (car xs) (car (cdr xs))))))
      (let ((names (fn (self xs seen)
                    (if (= xs nil) seen
                      (if (= (type-of (car xs)) 'symbol)
                        (if (member member (car xs) seen) (fail)
                          (if (member member (car xs) primitives) (fail)
                            (if (member member (car xs) '(if begin fn let quote module import export def defsyntax)) (fail)
                              (self self (cdr xs) (cons (car xs) seen))))) (fail)))))
            (scope (fn (self params locals)
                     (if (= params nil) locals (self self (cdr params) (cons (car params) locals)))))
            (static (fn (form)
                      (if (= (type-of form) 'list)
                        (if (= (car form) 'fn) form
                          (if (= (car form) 'quote) form (fail))) form)))
            (template
              (fn (self form args)
                (if (= (type-of form) 'symbol)
                  (if (member member form args) #t
                    (if (member member form primitives) #t
                      (if (= form 'if) #t (if (= form 'begin) #t (fail)))))
                  (if (= (type-of form) 'list)
                    (if (= (car form) 'quote)
                      (if (= (count form) 2) #t (fail))
                      (let ((many (fn (many xs)
                                    (if (= xs nil) #t
                                      (begin (self self (car xs) args) (many many (cdr xs)))))))
                        (many many form))) #t)))))
        (let ((substitute
                (fn (self form bindings)
                  (if (= (type-of form) 'symbol)
                    (if (has-key? bindings form) (get bindings form) form)
                    (if (= (type-of form) 'list)
                      (if (= (car form) 'quote) form
                        (let ((many (fn (many xs)
                                      (if (= xs nil) nil
                                        (cons (self self (car xs) bindings) (many many (cdr xs)))))))
                          (many many form))) form))))
              (pair (fn (self params args out)
                      (if (= params nil) (if (= args nil) out (fail))
                        (if (= args nil) (fail)
                          (self self (cdr params) (cdr args) (assoc out (car params) (car args))))))))
          (let ((expand
                  (fn (self form env locals depth)
                    (if (< 64 depth) (fail)
                      (if (= (type-of form) 'symbol)
                        (if (member member form locals) form
                          (if (has-key? env form)
                            (let ((item (get env form)))
                              (if (= (car item) 'value) (nth item 1) (fail)))
                            (if (member member form primitives) form (fail))))
                        (if (= (type-of form) 'list)
                          (let ((head (car form)) (tail (cdr form)))
                            (let ((many (fn (many xs scope)
                                          (if (= xs nil) nil
                                            (cons (self self (car xs) env scope (+ depth 1))
                                              (many many (cdr xs) scope))))))
                              (if (= head 'quote)
                                (if (= (count tail) 1) form (fail))
                                (if (= head 'let)
                                  (if (< (count tail) 2) (fail)
                                    (let ((bindings (fn (bindings pairs)
                                                      (if (= pairs nil) (list nil nil)
                                                        (if (= (count (car pairs)) 2)
                                                          (let ((rest (bindings bindings (cdr pairs))))
                                                            (list (cons (car (car pairs)) (car rest))
                                                              (cons (nth (car pairs) 1) (nth rest 1)))) (fail))))))
                                      (let ((parts (bindings bindings (car tail))))
                                        (self self (cons (cons 'fn (cons (car parts) (cdr tail))) (nth parts 1)) env locals (+ depth 1)))))
                                (if (= head 'fn)
                                  (if (< (count tail) 2) (fail)
                                    (let ((params (car tail)))
                                      (begin (names names params nil)
                                        (cons 'fn (cons params (many many (cdr tail) (scope scope params locals)))))))
                                  (if (= head 'if)
                                    (if (= (count tail) 3) (cons 'if (many many tail locals)) (fail))
                                    (if (= head 'begin) (cons 'begin (many many tail locals))
                                      (if (= (type-of head) 'symbol)
                                        (if (member member head locals)
                                          (cons head (many many tail locals))
                                          (if (has-key? env head)
                                            (let ((item (get env head)))
                                              (if (= (car item) 'syntax)
                                                (self self
                                                  (substitute substitute (car (cdr (cdr item)))
                                                    (pair pair (nth item 1) tail (dict))) env locals (+ depth 1))
                                                (cons (nth item 1) (many many tail locals))))
                                            (cons (self self head env locals (+ depth 1)) (many many tail locals))))
                                        (cons (self self head env locals (+ depth 1)) (many many tail locals)))))))))) form))))))
            (let ((merge (fn (self keys imported env)
                          (if (= keys nil) env
                            (if (has-key? env (car keys)) (fail)
                              (self self (cdr keys) imported (assoc env (car keys) (get imported (car keys))))))))
                  (exports (fn (self requested env out)
                             (if (= requested nil) out
                               (if (has-key? out (car requested)) (fail)
                                 (if (has-key? env (car requested))
                                   (self self (cdr requested) env (assoc out (car requested) (get env (car requested))))
                                   (fail)))))))
              (let ((body
                      (fn (self forms registry env requested)
                        (if (= forms nil) (exports exports requested env (dict))
                          (let ((form (car forms)))
                            (if (= (car form) 'import)
                              (if (= (count form) 2)
                                (if (has-key? registry (nth form 1))
                                  (let ((imported (get registry (nth form 1))))
                                    (self self (cdr forms) registry (merge merge (keys imported) imported env) requested))
                                  (fail)) (fail))
                              (if (= (car form) 'export)
                                (if (= requested nil)
                                  (if (= (cdr form) nil) (fail)
                                  (self self (cdr forms) registry env (cdr form))) (fail))
                                (let ((name (nth form 1)))
                                  (begin (names names (list name) nil)
                                    (if (has-key? env name) (fail)
                                      (if (= (car form) 'def)
                                        (if (= (count form) 3)
                                          (self self (cdr forms) registry
                                            (assoc env name (list 'value (expand expand (static (car (cdr (cdr form)))) env nil 0))) requested)
                                          (fail))
                                        (if (= (car form) 'defsyntax)
                                          (if (= (count form) 4)
                                            (let ((params (car (cdr (cdr form)))) (syntax (car (cdr (cdr (cdr form))))))
                                              (begin (names names params nil) (template template syntax params)
                                                (self self (cdr forms) registry (assoc env name (list 'syntax params syntax)) requested)))
                                            (fail)) (fail)))))))))))))
                (let ((link
                        (fn (self remaining registry)
                          (if (= remaining nil) registry
                            (let ((module (car remaining)))
                              (if (= (car module) 'module)
                                (if (< (count module) 3) (fail)
                                  (let ((name (nth module 1)))
                                    (begin (names names (list name) nil)
                                      (if (has-key? registry name) (fail)
                                        (self self (cdr remaining)
                                          (assoc registry name (body body (cdr (cdr module)) registry (dict) nil)))))))
                                (fail)))))))
                  (let ((registry (link link modules (dict))))
                    (if (has-key? registry entry-module)
                      (let ((public (get registry entry-module)))
                        (if (has-key? public entry-name)
                          (let ((entry (get public entry-name)))
                            (if (= (car entry) 'value) (nth entry 1) (fail))) (fail))) (fail))))))))))))
