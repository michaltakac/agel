; Construction APIs for the isolated compiled scheduler, not World/spawn actors.
(module agel/native-agents
  (import agel/native)
  (import agel/native-agent-kernel)
  (import agel/native-system-builder)
  (export native-empty native-spawn native-send native-system-source)
  (def require
    (fn (ok) (if ok #t (signal 'native/agents "invalid native actor construction"))))
  (def native-empty
    (fn (capacity)
      (begin (require (= (type-of capacity) 'int)) (require (< 0 capacity))
        (dict 'agents (dict) 'front nil 'back nil 'pending 0 'turns 0 'capacity capacity))))
  (def native-spawn
    (fn (world id kind state peers)
      (begin
        (require (= (type-of id) 'symbol))
        (require (= (type-of kind) 'symbol))
        (require (if (has-key? (get world 'agents) id) #f #t))
        (assoc world 'agents
          (assoc (get world 'agents) id (dict 'kind kind 'state state 'peers peers))))))
  (def native-send
    (fn (world receiver message)
      (begin
        (require (has-key? (get world 'agents) receiver))
        (require (< (get world 'pending) (get world 'capacity)))
        (assoc (assoc world 'back (cons (list receiver message) (get world 'back)))
          'pending (+ 1 (get world 'pending))))))
  (def native-system-source
    (fn (sources)
      (native-system-builder native-compile native-agent-kernel-source sources))))
