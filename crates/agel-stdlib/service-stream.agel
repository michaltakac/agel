(module agel/service-stream
  (import agel/services)
  (import agel/stream-buffer)
  (export service-stream)
  (def service-stream
    (fn (stream size)
      (let ((id (service-new "stream-buffer" buffer-request (buffer-new stream size))))
        (let ((call (fn (message)
                     (let ((reply (service-call id message)))
                       (if (get reply 'error)
                         (let ((problem (get reply 'error))) (signal (get problem 'kind) (get problem 'message))) reply)))))
          (dict 'owner id 'service id 'info (fn () (service-info id))
            'open (fn () (let ((answer ((get stream 'open)))) (call (dict 'operation 'reset)) answer))
            'close (fn () (let ((answer ((get stream 'close)))) (call (dict 'operation 'reset)) answer))
            'read-ready (fn () (get (call (dict 'operation 'read-ready)) 'ready))
            'read (fn (n) (begin (buffer-check-count n) (get (call (dict 'operation 'read 'count n)) 'bytes)))
            'write (get stream 'write) 'entropy (get stream 'entropy)
            'start-service (fn (function state) (call (dict 'operation 'start-service 'function function 'state state)))
            'pulse (fn () (call (dict 'operation 'pulse)))
            'stop-service (fn () (get (call (dict 'operation 'stop-service)) 'state)))))))
)
