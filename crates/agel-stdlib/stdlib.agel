; Agel standard library. The evaluator remains small; ordinary Agel code
; supplies reusable sequence, result, orchestration, and live UI abstractions.

(module agel/sequence
  (export append reverse map filter foldl each)

  (def append
    (fn (left right)
      (if (= left nil)
          right
          (cons (car left) (append (cdr left) right)))))

  (def reverse
    (fn (values)
      (foldl (fn (result value) (cons value result)) nil values)))

  (def map
    (fn (function values)
      (if (= values nil)
          nil
          (cons (function (car values)) (map function (cdr values))))))

  (def filter
    (fn (predicate values)
      (if (= values nil)
          nil
          (if (predicate (car values))
              (cons (car values) (filter predicate (cdr values)))
              (filter predicate (cdr values))))))

  (def foldl
    (fn (function initial values)
      (if (= values nil)
          initial
          (foldl function (function initial (car values)) (cdr values)))))

  (def each
    (fn (function values)
      (if (= values nil)
          nil
          (begin (function (car values)) (each function (cdr values)))))))

(module agel/result
  (export ok err ok? err? value error unwrap-or)

  (def ok (fn (value) (list 'ok value)))
  (def err (fn (problem) (list 'error problem)))
  (def ok? (fn (result) (= (car result) 'ok)))
  (def err? (fn (result) (= (car result) 'error)))
  (def value
    (fn (result)
      (if (ok? result)
          (car (cdr result))
          (signal 'result/not-ok "cannot take value from error" result))))
  (def error
    (fn (result)
      (if (err? result)
          (car (cdr result))
          (signal 'result/not-error "cannot take error from ok" result))))
  (def unwrap-or
    (fn (result fallback)
      (if (ok? result) (car (cdr result)) fallback))))

(module agel/swarm
  (import agel/sequence)
  (export worker-protocol pool-protocol make-worker make-pool submit)

  (defprotocol worker-protocol (work agent any))
  (defprotocol pool-protocol (submit agent any))

  (def worker-behavior
    (fn (self heap message)
      (begin
        (send (car (cdr message))
          (list 'result self
            ((get heap 'handler) (car (cdr (cdr message))))))
        heap)))

  (def make-worker
    (fn (name handler)
      (spawn name worker-behavior (dict 'handler handler) worker-protocol)))

  (def pool-behavior
    (fn (self workers message)
      (let ((worker (car workers))
            (reply (car (cdr message)))
            (payload (car (cdr (cdr message)))))
        (begin
          (send worker (list 'work reply payload))
          (append (cdr workers) (list worker))))))

  (def make-pool
    (fn (name workers)
      (if (= workers nil)
          (signal 'swarm/no-workers "worker pool cannot be empty")
          (spawn name pool-behavior workers pool-protocol))))

  (def submit
    (fn (pool reply payload)
      (send pool (list 'submit reply payload)))))

(module agel/meta
  (export meta-base-env meta-eval)

  (def meta-base-env
    (fn ()
      (dict
        '+ + '- - '* * '/ / '= = '< <
        'list list 'cons cons 'car car 'cdr cdr
        'dict dict 'get get 'assoc assoc 'count count
        'has-key? has-key? 'type-of type-of)))

  (def meta-require-arity
    (fn (arguments expected)
      (if (= (count arguments) expected)
          arguments
          (signal 'arity "malformed metacircular form" arguments))))

  (def meta-bind
    (fn (parameters arguments environment)
      (if (= (count parameters) (count arguments))
          (if (= parameters nil)
              environment
              (meta-bind
                (cdr parameters)
                (cdr arguments)
                (assoc environment (car parameters) (car arguments))))
          (signal 'arity "metacircular function arity mismatch" arguments))))

  (def meta-eval-list
    (fn (expressions environment)
      (if (= expressions nil)
          nil
          (cons
            (meta-eval (car expressions) environment)
            (meta-eval-list (cdr expressions) environment)))))

  (def meta-apply
    (fn (function arguments)
      (if (= (type-of function) 'list)
          (if (= (car function) 'meta/closure)
              (meta-eval
                (car (cdr (cdr function)))
                (meta-bind
                  (car (cdr function))
                  arguments
                  (car (cdr (cdr (cdr function))))))
              (signal 'meta/not-callable "invalid metacircular closure" function))
          (apply function arguments))))

  (def meta-eval
    (fn (expression environment)
      (if (= expression nil)
          nil
          (if (= (type-of expression) 'symbol)
              (if (has-key? environment expression)
                  (get environment expression)
                  (signal 'name/unbound "unbound metacircular name" expression))
              (if (= (type-of expression) 'list)
                  (let ((head (car expression))
                        (tail (cdr expression)))
                    (if (= head 'quote)
                        (car (meta-require-arity tail 1))
                        (if (= head 'if)
                            (let ((parts (meta-require-arity tail 3)))
                              (if (meta-eval (car parts) environment)
                                  (meta-eval (car (cdr parts)) environment)
                                  (meta-eval (car (cdr (cdr parts))) environment)))
                            (if (= head 'fn)
                                (let ((parts (meta-require-arity tail 2)))
                                  (list 'meta/closure
                                    (car parts)
                                    (car (cdr parts))
                                    environment))
                                (meta-apply
                                  (meta-eval head environment)
                                  (meta-eval-list tail environment))))))
                  expression))))))

; A retained, homoiconic UI and its transactional desktop agent. A UI is only
; persistent Agel data: renderers are replaceable boundary services, not owners
; of application state or behavior.
(module agel/ui
  (import agel/sequence)
  (export
    ui-spec node text button row column panel window theme intent
    node? scene? find-node
    set-prop replace-node set-children apply-patch apply-patches
    desktop-protocol make-desktop inspect propose commit discard rollback)

  (def ui-spec
    (dict
      'representation 'persistent-data
      'node-keys '(kind id props children)
      'patches '(set-prop replace-node set-children)
      'lifecycle '(inspect propose commit discard rollback)
      'safety '(unique-ids validated-preview transactional-turns)))

  (def second (fn (values) (car (cdr values))))
  (def third (fn (values) (car (cdr (cdr values)))))
  (def fourth (fn (values) (car (cdr (cdr (cdr values))))))

  (def node
    (fn (kind id props children)
      (dict 'kind kind 'id id 'props props 'children children)))

  (def text
    (fn (id content)
      (node 'text id (dict 'content content) nil)))

  (def button
    (fn (id label action)
      (node 'button id (dict 'label label 'action action) nil)))

  (def row (fn (id children) (node 'row id (dict) children)))
  (def column (fn (id children) (node 'column id (dict) children)))
  (def panel (fn (id children) (node 'panel id (dict) children)))

  (def window
    (fn (id title children)
      (node 'window id (dict 'title title) children)))

  (def theme
    (fn (name tokens)
      (dict 'kind 'theme 'name name 'tokens tokens)))

  ; Intents are semantic, inspectable actions. `requires` names the authority a
  ; future input broker must supply; a UI event never manufactures authority.
  (def intent
    (fn (action target payload requires)
      (dict 'kind 'intent 'action action 'target target
            'payload payload 'requires requires)))

  (def id-value?
    (fn (value)
      (if (= (type-of value) 'symbol)
          #t
          (= (type-of value) 'string))))

  (def children-value?
    (fn (value)
      (if (= value nil) #t (= (type-of value) 'list))))

  (def node-shape?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (has-key? value 'kind)
              (if (has-key? value 'id)
                  (if (has-key? value 'props)
                      (if (has-key? value 'children)
                          (if (= (type-of (get value 'kind)) 'symbol)
                              (if (id-value? (get value 'id))
                                  (if (= (type-of (get value 'props)) 'map)
                                      (children-value? (get value 'children))
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def valid-children?
    (fn (children)
      (if (= children nil)
          #t
          (if (node? (car children))
              (valid-children? (cdr children))
              #f))))

  (def node?
    (fn (value)
      (if (node-shape? value)
          (valid-children? (get value 'children))
          #f)))

  (def collect-child-ids
    (fn (children)
      (if (= children nil)
          nil
          (append
            (collect-ids (car children))
            (collect-child-ids (cdr children))))))

  (def collect-ids
    (fn (tree)
      (cons (get tree 'id) (collect-child-ids (get tree 'children)))))

  (def member?
    (fn (value values)
      (if (= values nil)
          #f
          (if (= value (car values))
              #t
              (member? value (cdr values))))))

  (def unique?
    (fn (values)
      (if (= values nil)
          #t
          (if (member? (car values) (cdr values))
              #f
              (unique? (cdr values))))))

  (def scene?
    (fn (tree)
      (if (node? tree)
          (unique? (collect-ids tree))
          #f)))

  (def find-in-children
    (fn (children id)
      (if (= children nil)
          nil
          (let ((found (find-node (car children) id)))
            (if (= found nil)
                (find-in-children (cdr children) id)
                found)))))

  (def find-node
    (fn (tree id)
      (if (= (get tree 'id) id)
          tree
          (find-in-children (get tree 'children) id))))

  ; Patches are also data and can be quoted, logged, reviewed, generated by an
  ; agent, or passed through a verifier before they reach a desktop.
  (def set-prop (fn (id key value) (list 'set-prop id key value)))
  (def replace-node (fn (id replacement) (list 'replace-node id replacement)))
  (def set-children (fn (id children) (list 'set-children id children)))

  (def rewrite-children
    (fn (children id transform)
      (if (= children nil)
          nil
          (cons
            (rewrite-node (car children) id transform)
            (rewrite-children (cdr children) id transform)))))

  (def rewrite-node
    (fn (tree id transform)
      (if (= (get tree 'id) id)
          (transform tree)
          (assoc tree 'children
            (rewrite-children (get tree 'children) id transform)))))

  (def require-target
    (fn (tree id)
      (if (= (find-node tree id) nil)
          (signal 'ui/unknown-node "patch target does not exist" id)
          tree)))

  (def apply-patch
    (fn (tree patch)
      (if (= (type-of patch) 'list)
          (let ((operation (car patch)))
            (if (= operation 'set-prop)
                (if (= (count patch) 4)
                    (begin
                      (require-target tree (second patch))
                      (rewrite-node tree (second patch)
                        (fn (target)
                          (assoc target 'props
                            (assoc (get target 'props) (third patch) (fourth patch))))))
                    (signal 'ui/invalid-patch "set-prop expects id, key, value" patch))
                (if (= operation 'replace-node)
                    (if (= (count patch) 3)
                        (begin
                          (require-target tree (second patch))
                          (rewrite-node tree (second patch) (fn (target) (third patch))))
                        (signal 'ui/invalid-patch "replace-node expects id, node" patch))
                    (if (= operation 'set-children)
                        (if (= (count patch) 3)
                            (begin
                              (require-target tree (second patch))
                              (rewrite-node tree (second patch)
                                (fn (target) (assoc target 'children (third patch)))))
                            (signal 'ui/invalid-patch "set-children expects id, children" patch))
                        (signal 'ui/invalid-patch "unknown UI patch operation" patch)))))
          (signal 'ui/invalid-patch "patch must be a list" patch))))

  (def apply-patches
    (fn (tree patches)
      (if (= patches nil)
          tree
          (apply-patches (apply-patch tree (car patches)) (cdr patches)))))

  (defprotocol desktop-protocol
    (inspect agent)
    (propose agent int list)
    (commit agent)
    (discard agent)
    (rollback agent))

  (def response
    (fn (reply tag revision value)
      (send reply (list tag revision value))))

  (def attempt-patches
    (fn (scene patches)
      (with-handler (* problem)
        (list 'error problem)
        (list 'ok (apply-patches scene patches)))))

  (def desktop-behavior
    (fn (self heap message)
      (let ((operation (car message))
            (reply (second message))
            (revision (get heap 'revision))
            (scene (get heap 'scene)))
        (if (= operation 'inspect)
            (begin
              (response reply 'desktop-state revision heap)
              heap)
            (if (= operation 'propose)
                (let ((base-revision (third message))
                      (patches (fourth message)))
                  (if (= base-revision revision)
                      (let ((attempt (attempt-patches scene patches)))
                        (if (= (car attempt) 'ok)
                            (let ((candidate (second attempt)))
                              (if (scene? candidate)
                                  (begin
                                    (response reply 'preview revision candidate)
                                    (assoc (assoc heap 'preview candidate) 'pending patches))
                                  (begin
                                    (response reply 'rejected revision
                                      (dict 'kind 'ui/invalid-scene 'patches patches))
                                    heap)))
                            (begin
                              (response reply 'rejected revision (second attempt))
                              heap)))
                      (begin
                        (response reply 'rejected revision
                          (dict 'kind 'ui/stale-revision
                                'expected revision 'actual base-revision))
                        heap)))
                (if (= operation 'commit)
                    (if (= (get heap 'preview) nil)
                        (begin
                          (response reply 'unchanged revision scene)
                          heap)
                        (let ((candidate (get heap 'preview))
                              (next-revision (+ revision 1)))
                          (begin
                            (response reply 'committed next-revision candidate)
                            (assoc
                              (assoc
                                (assoc
                                  (assoc
                                    (assoc heap 'previous scene)
                                    'scene candidate)
                                  'preview nil)
                                'pending nil)
                              'revision next-revision))))
                    (if (= operation 'discard)
                        (begin
                          (response reply 'discarded revision scene)
                          (assoc (assoc heap 'preview nil) 'pending nil))
                        (if (= (get heap 'previous) nil)
                            (begin
                              (response reply 'unchanged revision scene)
                              heap)
                            (let ((previous (get heap 'previous))
                                  (next-revision (+ revision 1)))
                              (begin
                                (response reply 'rolled-back next-revision previous)
                                (assoc
                                  (assoc
                                    (assoc
                                      (assoc
                                        (assoc heap 'previous scene)
                                        'scene previous)
                                      'preview nil)
                                    'pending nil)
                                  'revision next-revision)))))))))))

  (def make-desktop
    (fn (name initial-scene)
      (if (scene? initial-scene)
          (spawn name desktop-behavior
            (dict 'scene initial-scene 'preview nil 'previous nil
                  'pending nil 'revision 0)
            desktop-protocol)
          (signal 'ui/invalid-scene "desktop requires a valid initial scene"
            initial-scene))))

  (def inspect (fn (desktop reply) (send desktop (list 'inspect reply))))
  (def propose
    (fn (desktop reply base-revision patches)
      (send desktop (list 'propose reply base-revision patches))))
  (def commit (fn (desktop reply) (send desktop (list 'commit reply))))
  (def discard (fn (desktop reply) (send desktop (list 'discard reply))))
  (def rollback (fn (desktop reply) (send desktop (list 'rollback reply)))))

; Resolution-independent graphics are ordinary Agel values. Coordinates use
; logical pixels; a frame's integer scale selects physical output density
; without changing layout or hit-testing. The small native renderer validates
; this IR again before touching an output surface.
(module agel/vector
  (import agel/sequence)
  (export
    vector-spec point transform identity-transform solid linear-gradient
    move-to line-to curve-to close-path path rounded-rectangle ellipse
    fill-shape stroke-shape draw-vector-text push-transform push-clip restore
    paint? shape? vector-command? vector-commands? balanced-vector-commands?)

  (def vector-spec
    (dict
      'coordinates 'logical-integer-pixels
      'density 'integer-output-scale
      'shapes '(rounded-rectangle ellipse path)
      'path-segments '(move-to line-to curve-to close-path)
      'paints '(solid linear-gradient)
      'paint-space 'object-bounding-box-1024
      'state '(transform clip restore)
      'safety '(strict-validation balanced-state-stack host-revalidation)
      'ownership 'agel))

  (def integer? (fn (value) (= (type-of value) 'int)))
  (def positive? (fn (value) (if (integer? value) (< 0 value) #f)))
  (def nonnegative? (fn (value) (if (integer? value) (if (< value 0) #f #t) #f)))
  (def string? (fn (value) (= (type-of value) 'string)))
  (def id?
    (fn (value)
      (if (= (type-of value) 'symbol)
          #t
          (if (= (type-of value) 'string)
              #t
              (= (type-of value) 'int)))))

  (def point (fn (x y) (dict 'kind 'point 'x x 'y y)))
  (def transform
    (fn (a b c d tx ty)
      (dict 'kind 'transform 'a a 'b b 'c c 'd d 'tx tx 'ty ty)))
  (def identity-transform (transform 1024 0 0 1024 0 0))
  (def solid (fn (color) (dict 'kind 'solid 'color color)))
  (def linear-gradient
    (fn (from to start end)
      (dict 'kind 'linear-gradient 'from from 'to to
            'start start 'end end)))

  (def move-to (fn (x y) (dict 'op 'move-to 'x x 'y y)))
  (def line-to (fn (x y) (dict 'op 'line-to 'x x 'y y)))
  (def curve-to
    (fn (x1 y1 x2 y2 x y)
      (dict 'op 'curve-to 'x1 x1 'y1 y1 'x2 x2 'y2 y2 'x x 'y y)))
  (def close-path (fn () (dict 'op 'close-path)))
  (def path (fn (segments) (dict 'kind 'path 'segments segments)))
  (def rounded-rectangle
    (fn (bounds radius)
      (dict 'kind 'rounded-rectangle 'bounds bounds 'radius radius)))
  (def ellipse
    (fn (center radius-x radius-y)
      (dict 'kind 'ellipse 'center center 'radius-x radius-x 'radius-y radius-y)))

  (def fill-shape
    (fn (id geometry paint)
      (dict 'op 'fill-shape 'id id 'shape geometry 'paint paint)))
  (def stroke-shape
    (fn (id geometry paint width)
      (dict 'op 'stroke-shape 'id id 'shape geometry 'paint paint 'width width)))
  (def draw-vector-text
    (fn (id bounds content paint role)
      (dict 'op 'draw-text 'id id 'bounds bounds 'content content
            'paint paint 'role role)))
  (def push-transform (fn (matrix) (dict 'op 'push-transform 'transform matrix)))
  (def push-clip (fn (geometry) (dict 'op 'push-clip 'shape geometry)))
  (def restore (fn () (dict 'op 'restore)))

  (def point?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (= (get value 'kind) 'point)
              (if (integer? (get value 'x)) (integer? (get value 'y)) #f)
              #f)
          #f)))

  (def transform?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (= (get value 'kind) 'transform)
              (if (integer? (get value 'a))
                  (if (integer? (get value 'b))
                      (if (integer? (get value 'c))
                          (if (integer? (get value 'd))
                              (if (integer? (get value 'tx))
                                  (integer? (get value 'ty)) #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def color? (fn (value) (string? value)))
  (def normalized-point?
    (fn (value)
      (if (point? value)
          (if (nonnegative? (get value 'x))
              (if (< (get value 'x) 1025)
                  (if (nonnegative? (get value 'y))
                      (< (get value 'y) 1025) #f)
                  #f)
              #f)
          #f)))
  (def paint?
    (fn (value)
      (if (string? value)
          #t
          (if (= (type-of value) 'map)
              (if (= (get value 'kind) 'solid)
                  (color? (get value 'color))
                  (if (= (get value 'kind) 'linear-gradient)
                      (if (normalized-point? (get value 'from))
                          (if (normalized-point? (get value 'to))
                              (if (color? (get value 'start))
                                  (color? (get value 'end)) #f)
                              #f)
                          #f)
                      #f))
              #f))))

  (def rect-shape?
    (fn (value)
      (if (= (type-of (get value 'bounds)) 'map)
          (if (integer? (get (get value 'bounds) 'x))
              (if (integer? (get (get value 'bounds) 'y))
                  (if (positive? (get (get value 'bounds) 'width))
                      (positive? (get (get value 'bounds) 'height)) #f)
                  #f)
              #f)
          #f)))

  (def segment?
    (fn (segment)
      (if (= (type-of segment) 'map)
          (let ((operation (get segment 'op)))
            (if (= operation 'close-path)
                #t
                (if (= operation 'move-to)
                    (if (integer? (get segment 'x)) (integer? (get segment 'y)) #f)
                    (if (= operation 'line-to)
                        (if (integer? (get segment 'x)) (integer? (get segment 'y)) #f)
                        (if (= operation 'curve-to)
                            (if (integer? (get segment 'x1))
                                (if (integer? (get segment 'y1))
                                    (if (integer? (get segment 'x2))
                                        (if (integer? (get segment 'y2))
                                            (if (integer? (get segment 'x))
                                                (integer? (get segment 'y)) #f)
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)))))
          #f)))

  (def segments?
    (fn (segments)
      (if (= segments nil)
          #t
          (if (segment? (car segments)) (segments? (cdr segments)) #f))))

  (def shape?
    (fn (value)
      (if (= (type-of value) 'map)
          (let ((kind (get value 'kind)))
            (if (= kind 'rounded-rectangle)
                (if (rect-shape? value) (nonnegative? (get value 'radius)) #f)
                (if (= kind 'ellipse)
                    (if (point? (get value 'center))
                        (if (positive? (get value 'radius-x))
                            (positive? (get value 'radius-y)) #f)
                        #f)
                    (if (= kind 'path)
                        (if (= (get value 'segments) nil)
                            #f
                            (segments? (get value 'segments)))
                        #f))))
          #f)))

  (def vector-command?
    (fn (command)
      (if (= (type-of command) 'map)
          (if (has-key? command 'op)
              (let ((operation (get command 'op)))
                (if (= operation 'fill-shape)
                    (if (id? (get command 'id))
                        (if (shape? (get command 'shape))
                            (paint? (get command 'paint)) #f)
                        #f)
                    (if (= operation 'stroke-shape)
                        (if (id? (get command 'id))
                            (if (shape? (get command 'shape))
                                (if (paint? (get command 'paint))
                                    (positive? (get command 'width)) #f)
                                #f)
                            #f)
                        (if (= operation 'draw-text)
                            (if (id? (get command 'id))
                                (if (rect-shape? (dict 'bounds (get command 'bounds)))
                                    (if (string? (get command 'content))
                                        (if (= (type-of (get command 'role)) 'symbol)
                                            (paint? (get command 'paint)) #f)
                                        #f)
                                    #f)
                                #f)
                            (if (= operation 'push-transform)
                                (transform? (get command 'transform))
                                (if (= operation 'push-clip)
                                    (shape? (get command 'shape))
                                    (= operation 'restore)))))))
              #f)
          #f)))

  (def vector-commands?
    (fn (commands)
      (if (= commands nil)
          #t
          (if (vector-command? (car commands))
              (vector-commands? (cdr commands)) #f))))

  (def state-depth
    (fn (commands depth)
      (if (= commands nil)
          depth
          (let ((operation (get (car commands) 'op)))
            (if (= operation 'restore)
                (if (= depth 0) -1 (state-depth (cdr commands) (- depth 1)))
                (if (= operation 'push-transform)
                    (state-depth (cdr commands) (+ depth 1))
                    (if (= operation 'push-clip)
                        (state-depth (cdr commands) (+ depth 1))
                        (state-depth (cdr commands) depth))))))))

  (def balanced-vector-commands?
    (fn (commands)
      (if (vector-commands? commands) (= (state-depth commands 0) 0) #f))))

; Deterministic layout compiles a semantic scene to a renderer-neutral display
; frame. The native renderer will consume these values; it does not own layout,
; theme, hit-testing, or action meaning.
(module agel/ui-layout
  (import agel/sequence)
  (import agel/ui)
  (import agel/vector)
  (export
    layout-spec cosmic-theme rect rect? theme? compile-frame frame?
    display-list hit-test layout-protocol make-layout-agent render-frame hit-point)

  (def layout-spec
    (dict
      'input '(scene viewport theme)
      'output '(boxes commands actions)
      'directions '(row column)
      'commands '(fill stroke text)
      'partition 'fixed-basis-plus-equal-flex
      'hit-order 'last-action-first
      'safety '(checked-arithmetic positive-extents bounded-by-runtime)))

  (def cosmic-theme
    (theme 'cosmic
      (dict
        'background "#11131a"
        'surface (linear-gradient (point 0 0) (point 0 1024) "#303544" "#20232e")
        'panel "#252936"
        'text "#f4f6ff"
        'muted-text "#aeb5ca"
        'accent (linear-gradient (point 0 0) (point 0 1024) "#8b7cff" "#6655e8")
        'on-accent "#ffffff"
        'border "#454b61"
        'padding 12
        'gap 8
        'titlebar-height 32
        'corner-radius 8)))

  (def second (fn (values) (car (cdr values))))
  (def integer? (fn (value) (= (type-of value) 'int)))
  (def theme-name?
    (fn (value)
      (if (= (type-of value) 'symbol) #t (= (type-of value) 'string))))
  (def positive? (fn (value) (if (integer? value) (< 0 value) #f)))
  (def nonnegative? (fn (value) (if (integer? value) (if (< value 0) #f #t) #f)))

  (def rect
    (fn (x y width height)
      (dict 'x x 'y y 'width width 'height height)))

  (def rect?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (has-key? value 'x)
              (if (has-key? value 'y)
                  (if (has-key? value 'width)
                      (if (has-key? value 'height)
                          (if (integer? (get value 'x))
                              (if (integer? (get value 'y))
                                  (if (positive? (get value 'width))
                                      (positive? (get value 'height))
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def required-tokens
    '(background surface panel text muted-text accent on-accent border
      padding gap titlebar-height corner-radius))

  (def paint-tokens
    '(background surface panel text muted-text accent on-accent border))

  (def has-tokens?
    (fn (tokens names)
      (if (= names nil)
          #t
          (if (has-key? tokens (car names))
              (has-tokens? tokens (cdr names))
              #f))))

  (def paints?
    (fn (tokens names)
      (if (= names nil)
          #t
          (if (paint? (get tokens (car names)))
              (paints? tokens (cdr names))
              #f))))

  (def theme?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (= (get value 'kind) 'theme)
              (if (theme-name? (get value 'name))
                  (let ((tokens (get value 'tokens)))
                    (if (= (type-of tokens) 'map)
                        (if (has-tokens? tokens required-tokens)
                            (if (paints? tokens paint-tokens)
                                (if (nonnegative? (get tokens 'padding))
                                    (if (nonnegative? (get tokens 'gap))
                                        (if (positive? (get tokens 'titlebar-height))
                                            (nonnegative? (get tokens 'corner-radius))
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)
                        #f))
                  #f)
              #f)
          #f)))

  (def token (fn (style name) (get (get style 'tokens) name)))

  (def prop-or
    (fn (tree name fallback)
      (if (has-key? (get tree 'props) name)
          (get (get tree 'props) name)
          fallback)))

  (def node-padding
    (fn (tree style)
      (let ((kind (get tree 'kind)))
        (prop-or tree 'padding
          (if (= kind 'window)
              (token style 'padding)
              (if (= kind 'panel) (token style 'padding) 0))))))

  (def node-gap
    (fn (tree style)
      (prop-or tree 'gap (token style 'gap))))

  (def require-space
    (fn (width height context)
      (if (positive? width)
          (if (positive? height)
              #t
              (signal 'ui/layout-overflow "layout has no vertical space" context))
          (signal 'ui/layout-overflow "layout has no horizontal space" context))))

  (def content-rect
    (fn (tree bounds style)
      (let ((padding (node-padding tree style))
            (kind (get tree 'kind))
            (titlebar (if (= (get tree 'kind) 'window)
                          (token style 'titlebar-height)
                          0)))
        (if (nonnegative? padding)
            (let ((x (+ (get bounds 'x) padding))
                  (y (+ (get bounds 'y) padding titlebar))
                  (width (- (get bounds 'width) (* padding 2)))
                  (height (- (get bounds 'height) (* padding 2) titlebar)))
              (begin
                (require-space width height (get tree 'id))
                (rect x y width height)))
            (signal 'ui/invalid-layout "padding must be a non-negative integer"
              (dict 'id (get tree 'id) 'padding padding))))))

  (def empty-render
    (fn () (dict 'boxes nil 'commands nil 'actions nil)))

  (def merge-render
    (fn (left right)
      (dict
        'boxes (append (get left 'boxes) (get right 'boxes))
        'commands (append (get left 'commands) (get right 'commands))
        'actions (append (get left 'actions) (get right 'actions)))))

  (def box
    (fn (tree bounds)
      (dict 'id (get tree 'id) 'kind (get tree 'kind) 'bounds bounds)))

  (def fill
    (fn (id bounds color radius)
      (dict 'op 'fill 'id id 'bounds bounds 'color color 'radius radius)))

  (def stroke
    (fn (id bounds color)
      (dict 'op 'stroke 'id id 'bounds bounds 'color color)))

  (def label
    (fn (id bounds content color role)
      (dict 'op 'text 'id id 'bounds bounds 'content content
            'color color 'role role)))

  (def titlebar-rect
    (fn (bounds style)
      (rect (get bounds 'x) (get bounds 'y) (get bounds 'width)
            (token style 'titlebar-height))))

  (def node-commands
    (fn (tree bounds style)
      (let ((kind (get tree 'kind))
            (id (get tree 'id))
            (props (get tree 'props))
            (corner (token style 'corner-radius)))
        (if (= kind 'window)
            (if (< (get bounds 'height) (token style 'titlebar-height))
                (signal 'ui/layout-overflow "window is shorter than its titlebar" id)
                (list
                  (fill id bounds (token style 'background) 0)
                  (fill id (titlebar-rect bounds style) (token style 'surface) 0)
                  (label id (titlebar-rect bounds style) (get props 'title)
                         (token style 'text) 'title)))
            (if (= kind 'panel)
                (list
                  (fill id bounds (token style 'panel) corner)
                  (stroke id bounds (token style 'border)))
                (if (= kind 'button)
                    (list
                      (fill id bounds (token style 'accent) corner)
                      (label id bounds (get props 'label)
                             (token style 'on-accent) 'button))
                    (if (= kind 'text)
                        (list
                          (label id bounds (get props 'content)
                                 (token style 'text) 'body))
                        nil)))))))

  (def node-actions
    (fn (tree bounds)
      (if (has-key? (get tree 'props) 'action)
          (list
            (dict 'id (get tree 'id) 'bounds bounds
                  'intent (get (get tree 'props) 'action)))
          nil)))

  ; A child may request a fixed main-axis `basis`. Children without one share
  ; the remaining space; the last flexible child receives the integer remainder.
  (def basis-total
    (fn (children)
      (if (= children nil)
          0
          (let ((props (get (car children) 'props)))
            (if (has-key? props 'basis)
                (if (positive? (get props 'basis))
                    (+ (get props 'basis) (basis-total (cdr children)))
                    (signal 'ui/invalid-layout "basis must be a positive integer"
                      (dict 'id (get (car children) 'id)
                            'basis (get props 'basis))))
                (basis-total (cdr children)))))))

  (def flex-count
    (fn (children)
      (if (= children nil)
          0
          (+ (if (has-key? (get (car children) 'props) 'basis) 0 1)
             (flex-count (cdr children))))))

  (def layout-horizontal-rest
    (fn (children x y height unit flex-remaining flex-left gap style)
      (if (= children nil)
          (empty-render)
          (let ((fixed (has-key? (get (car children) 'props) 'basis))
                (width
                  (if (has-key? (get (car children) 'props) 'basis)
                      (get (get (car children) 'props) 'basis)
                      (if (= flex-left 1) flex-remaining unit))))
            (merge-render
              (compile-node (car children) (rect x y width height) style)
              (layout-horizontal-rest
                (cdr children) (+ x width gap) y height unit
                (if fixed flex-remaining (- flex-remaining width))
                (if fixed flex-left (- flex-left 1)) gap style))))))

  (def layout-horizontal
    (fn (children bounds gap style)
      (let ((n (count children))
            (fixed (basis-total children))
            (flexible (flex-count children))
            (available (- (get bounds 'width) (* gap (- (count children) 1)))))
        (let ((remaining (- available fixed)))
          (if (< available fixed)
              (signal 'ui/layout-overflow "fixed row children exceed available width"
                (dict 'bounds bounds 'fixed fixed 'gap gap))
              (if (= flexible 0)
                  (layout-horizontal-rest
                    children (get bounds 'x) (get bounds 'y) (get bounds 'height)
                    0 0 0 gap style)
                  (if (< remaining flexible)
                      (signal 'ui/layout-overflow "row cannot give each flexible child one pixel"
                        (dict 'bounds bounds 'children n 'fixed fixed 'gap gap))
                      (layout-horizontal-rest
                        children (get bounds 'x) (get bounds 'y) (get bounds 'height)
                        (/ remaining flexible) remaining flexible gap style))))))))

  (def layout-vertical-rest
    (fn (children x y width unit flex-remaining flex-left gap style)
      (if (= children nil)
          (empty-render)
          (let ((fixed (has-key? (get (car children) 'props) 'basis))
                (height
                  (if (has-key? (get (car children) 'props) 'basis)
                      (get (get (car children) 'props) 'basis)
                      (if (= flex-left 1) flex-remaining unit))))
            (merge-render
              (compile-node (car children) (rect x y width height) style)
              (layout-vertical-rest
                (cdr children) x (+ y height gap) width unit
                (if fixed flex-remaining (- flex-remaining height))
                (if fixed flex-left (- flex-left 1)) gap style))))))

  (def layout-vertical
    (fn (children bounds gap style)
      (let ((n (count children))
            (fixed (basis-total children))
            (flexible (flex-count children))
            (available (- (get bounds 'height) (* gap (- (count children) 1)))))
        (let ((remaining (- available fixed)))
          (if (< available fixed)
              (signal 'ui/layout-overflow "fixed column children exceed available height"
                (dict 'bounds bounds 'fixed fixed 'gap gap))
              (if (= flexible 0)
                  (layout-vertical-rest
                    children (get bounds 'x) (get bounds 'y) (get bounds 'width)
                    0 0 0 gap style)
                  (if (< remaining flexible)
                      (signal 'ui/layout-overflow "column cannot give each flexible child one pixel"
                        (dict 'bounds bounds 'children n 'fixed fixed 'gap gap))
                      (layout-vertical-rest
                        children (get bounds 'x) (get bounds 'y) (get bounds 'width)
                        (/ remaining flexible) remaining flexible gap style))))))))

  (def compile-children
    (fn (tree bounds style)
      (let ((children (get tree 'children))
            (inside (content-rect tree bounds style))
            (gap (node-gap tree style)))
        (if (nonnegative? gap)
            (if (= (get tree 'kind) 'row)
                (layout-horizontal children inside gap style)
                (layout-vertical children inside gap style))
            (signal 'ui/invalid-layout "gap must be a non-negative integer"
              (dict 'id (get tree 'id) 'gap gap))))))

  (def compile-node
    (fn (tree bounds style)
      (let ((children-result
              (if (= (get tree 'children) nil)
                  (empty-render)
                  (compile-children tree bounds style))))
        (dict
          'boxes (cons (box tree bounds) (get children-result 'boxes))
          'commands (append (node-commands tree bounds style)
                            (get children-result 'commands))
          'actions (append (node-actions tree bounds)
                           (get children-result 'actions))))))

  (def command?
    (fn (command)
      (if (= (type-of command) 'map)
          (if (has-key? command 'op)
              (if (has-key? command 'id)
                  (if (has-key? command 'bounds)
                      (if (rect? (get command 'bounds))
                          (let ((operation (get command 'op)))
                                (if (= operation 'fill)
                                    (if (has-key? command 'color)
                                    (if (paint? (get command 'color))
                                        (if (has-key? command 'radius)
                                            (nonnegative? (get command 'radius))
                                            #f)
                                        #f)
                                    #f)
                                (if (= operation 'stroke)
                                    (if (has-key? command 'color)
                                        (paint? (get command 'color))
                                        #f)
                                    (if (= operation 'text)
                                        (if (has-key? command 'content)
                                            (if (= (type-of (get command 'content)) 'string)
                                                (if (has-key? command 'color)
                                                    (if (paint? (get command 'color))
                                                        (has-key? command 'role)
                                                        #f)
                                                    #f)
                                                #f)
                                            #f)
                                        #f))))
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def commands?
    (fn (commands)
      (if (= commands nil)
          #t
          (if (command? (car commands))
              (commands? (cdr commands))
              #f))))

  (def boxes?
    (fn (boxes)
      (if (= boxes nil)
          #t
          (if (= (type-of (car boxes)) 'map)
              (if (has-key? (car boxes) 'id)
                  (if (has-key? (car boxes) 'kind)
                      (if (rect? (get (car boxes) 'bounds))
                          (boxes? (cdr boxes))
                          #f)
                      #f)
                  #f)
              #f))))

  (def action?
    (fn (action)
      (if (= (type-of action) 'map)
          (if (has-key? action 'id)
              (if (rect? (get action 'bounds))
                  (if (has-key? action 'intent)
                      (if (= (type-of (get action 'intent)) 'map)
                          (= (get (get action 'intent) 'kind) 'intent)
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def actions?
    (fn (actions)
      (if (= actions nil)
          #t
          (if (action? (car actions))
              (actions? (cdr actions))
              #f))))

  (def frame?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (= (get value 'kind) 'display-frame)
              (if (rect? (get value 'viewport))
                  (if (theme-name? (get value 'theme))
                      (if (has-key? value 'boxes)
                          (if (boxes? (get value 'boxes))
                              (if (has-key? value 'commands)
                                  (if (commands? (get value 'commands))
                                      (if (has-key? value 'actions)
                                          (actions? (get value 'actions))
                                          #f)
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def compile-frame
    (fn (scene viewport style)
      (if (scene? scene)
          (if (rect? viewport)
              (if (theme? style)
                  (let ((result (compile-node scene viewport style)))
                    (let ((frame
                            (dict
                              'kind 'display-frame
                              'viewport viewport
                              'theme (get style 'name)
                              'boxes (get result 'boxes)
                              'commands (get result 'commands)
                              'actions (get result 'actions))))
                      (if (frame? frame)
                          frame
                          (signal 'ui/invalid-display-list
                            "scene compiled to an invalid display frame" frame))))
                  (signal 'ui/invalid-theme "layout requires a valid theme" style))
              (signal 'ui/invalid-viewport "layout requires a positive rectangle" viewport))
          (signal 'ui/invalid-scene "layout requires a valid scene" scene))))

  (def display-list (fn (frame) (get frame 'commands)))

  (def point-in?
    (fn (bounds x y)
      (if (< x (get bounds 'x))
          #f
          (if (< y (get bounds 'y))
              #f
              (if (< x (+ (get bounds 'x) (get bounds 'width)))
                  (< y (+ (get bounds 'y) (get bounds 'height)))
                  #f)))))

  (def hit-actions
    (fn (actions x y)
      (if (= actions nil)
          nil
          (if (point-in? (get (car actions) 'bounds) x y)
              (car actions)
              (hit-actions (cdr actions) x y)))))

  (def hit-test
    (fn (frame x y)
      (if (integer? x)
          (if (integer? y)
              (hit-actions (reverse (get frame 'actions)) x y)
              (signal 'ui/invalid-point "hit-test y must be an integer" y))
          (signal 'ui/invalid-point "hit-test x must be an integer" x))))

  ; The layout engine itself is an agent. Rendering commits a new frame in one
  ; turn; semantic hit-testing never executes the returned intent.
  (defprotocol layout-protocol
    (render agent map map map)
    (hit agent int int))

  (def attempt-frame
    (fn (scene viewport style)
      (with-handler (* problem)
        (list 'error problem)
        (list 'ok (compile-frame scene viewport style)))))

  (def layout-behavior
    (fn (self heap message)
      (let ((operation (car message))
            (reply (second message)))
        (if (= operation 'render)
            (let ((attempt
                    (attempt-frame
                      (car (cdr (cdr message)))
                      (car (cdr (cdr (cdr message))))
                      (car (cdr (cdr (cdr (cdr message))))))))
              (if (= (car attempt) 'ok)
                  (begin
                    (send reply (list 'rendered (second attempt)))
                    (dict 'frame (second attempt)))
                  (begin
                    (send reply (list 'render-rejected (second attempt)))
                    heap)))
            (if (= (get heap 'frame) nil)
                (begin
                  (send reply (list 'miss nil))
                  heap)
                (let ((hit
                        (hit-test (get heap 'frame)
                          (car (cdr (cdr message)))
                          (car (cdr (cdr (cdr message)))))))
                  (begin
                    (send reply (if (= hit nil)
                                    (list 'miss nil)
                                    (list 'action hit)))
                    heap)))))))

  (def make-layout-agent
    (fn (name)
      (spawn name layout-behavior (dict 'frame nil) layout-protocol)))

  (def render-frame
    (fn (layout-agent reply scene viewport style)
      (send layout-agent (list 'render reply scene viewport style))))

  (def hit-point
    (fn (layout-agent reply x y)
      (send layout-agent (list 'hit reply x y)))))

; The bridge from UI layout to the vector compositor is also Agel. It turns
; the generic display list into a density-independent vector display list and
; retains semantic action regions unchanged.
(module agel/ui-vector
  (import agel/sequence)
  (import agel/ui-layout)
  (import agel/vector)
  (export
    ui-vector-spec compile-vector-frame vector-frame? vector-display-list
    vector-protocol make-vector-agent vectorize-frame)

  (def ui-vector-spec
    (dict
      'input 'display-frame
      'output 'vector-frame
      'logical-units 'pixels
      'physical-density 'integer-scale
      'translation '(fill-to-shape stroke-to-shape text-to-vector-text)
      'failure 'retain-last-good-vector-frame))

  (def integer? (fn (value) (= (type-of value) 'int)))
  (def positive? (fn (value) (if (integer? value) (< 0 value) #f)))

  (def vectorize-command
    (fn (command)
      (let ((operation (get command 'op))
            (id (get command 'id))
            (bounds (get command 'bounds)))
        (if (= operation 'fill)
            (fill-shape id
              (rounded-rectangle bounds (get command 'radius))
              (get command 'color))
            (if (= operation 'stroke)
                (stroke-shape id (rounded-rectangle bounds 8)
                  (get command 'color) 1)
                (draw-vector-text id bounds (get command 'content)
                  (get command 'color) (get command 'role)))))))

  (def vectorize-commands
    (fn (commands)
      (if (= commands nil)
          nil
          (cons (vectorize-command (car commands))
                (vectorize-commands (cdr commands))))))

  (def vector-frame?
    (fn (value)
      (if (= (type-of value) 'map)
          (if (= (get value 'kind) 'vector-frame)
              (if (rect? (get value 'viewport))
                  (if (positive? (get value 'scale))
                      (if (positive? (get value 'physical-width))
                          (if (positive? (get value 'physical-height))
                              (if (balanced-vector-commands?
                                    (get value 'commands))
                                  (= (type-of (get value 'actions)) 'list)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f)))

  (def compile-vector-frame
    (fn (frame scale)
      (if (frame? frame)
          (if (positive? scale)
              (let ((viewport (get frame 'viewport))
                    (commands (vectorize-commands (display-list frame))))
                (let ((result
                        (dict
                          'kind 'vector-frame
                          'viewport viewport
                          'scale scale
                          'physical-width (* (get viewport 'width) scale)
                          'physical-height (* (get viewport 'height) scale)
                          'commands commands
                          'actions (get frame 'actions))))
                  (if (vector-frame? result)
                      result
                      (signal 'vector/invalid-frame
                        "vector compiler produced an invalid frame" result))))
              (signal 'vector/invalid-scale
                "output scale must be a positive integer" scale))
          (signal 'vector/invalid-source-frame
            "vector compiler requires a valid display frame" frame))))

  (def vector-display-list (fn (frame) (get frame 'commands)))

  (defprotocol vector-protocol (vectorize agent map int))

  (def attempt-vector-frame
    (fn (frame scale)
      (with-handler (* problem)
        (list 'error problem)
        (list 'ok (compile-vector-frame frame scale)))))

  (def vector-behavior
    (fn (self heap message)
      (let ((reply (car (cdr message)))
            (attempt (attempt-vector-frame
                       (car (cdr (cdr message)))
                       (car (cdr (cdr (cdr message)))))))
        (if (= (car attempt) 'ok)
            (begin
              (send reply (list 'vectorized (car (cdr attempt))))
              (dict 'frame (car (cdr attempt))))
            (begin
              (send reply (list 'vector-rejected (car (cdr attempt))))
              heap)))))

  (def make-vector-agent
    (fn (name)
      (spawn name vector-behavior (dict 'frame nil) vector-protocol)))

  (def vectorize-frame
    (fn (vector-agent reply frame scale)
      (send vector-agent (list 'vectorize reply frame scale)))))

; The default shell is policy-free Agel data. Users and agents can replace any
; part while keeping the same layout and renderer contracts.
(module agel/desktop
  (import agel/ui)
  (import agel/ui-layout)
  (export desktop-spec default-scene default-theme default-viewport)

  (def desktop-spec
    (dict
      'inspiration 'cosmic
      'components '(panel workspaces applets launcher workspace dock)
      'mutation '(inspect propose preview commit rollback)
      'automation 'semantic-intents
      'principle 'agents-all-the-way-down))

  (def default-theme cosmic-theme)
  (def default-viewport (rect 0 0 1280 800))

  (def app-intent
    (fn (name) (intent 'application/open name nil 'application/launch)))

  (def sized
    (fn (tree basis)
      (assoc tree 'props (assoc (get tree 'props) 'basis basis))))

  (def default-scene
    (fn ()
      (window 'desktop "Agel"
        (list
          (sized
            (row 'panel
              (list
                (button 'launcher "Applications"
                  (intent 'launcher/toggle 'launcher nil 'desktop/control))
                (button 'workspace-one "Workspace 1"
                  (intent 'workspace/focus 1 nil 'desktop/control))
                (text 'clock "Agel time")
                (button 'quick-settings "Sound · Network · Power"
                  (intent 'settings/toggle 'quick-settings nil 'settings/read))))
            56)
          (panel 'workspace
            (list
              (column 'welcome
                (list
                  (text 'headline "Welcome to your moldable operating system")
                  (text 'hint
                    "Ask an agent to reshape any component, then inspect its preview.")))))
          (sized
            (row 'dock
              (list
                (button 'terminal "Terminal" (app-intent 'terminal))
                (button 'files "Files" (app-intent 'files))
                (button 'workshop "Workshop" (app-intent 'workshop))
                (button 'settings "Settings" (app-intent 'settings))
                (button 'agent "Ask Agel"
                  (intent 'agent/converse 'system-agent nil 'model/infer))))
            72))))))
